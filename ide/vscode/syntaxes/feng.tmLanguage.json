{
  "name": "Fēng",
  "scopeName": "source.feng",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#storage-types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.feng",
          "match": "//.*$"
        },
        {
          "name": "comment.block.feng",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.feng",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.feng",
          "match": "\\\\(?:[btnfr\"'\\\\]|[0-7]{1,3}|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.feng",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b|\\b\\d+[eE][+-]?\\d+\\b|\\b\\d+\\.\\b"
        },
        {
          "name": "constant.numeric.hex.feng",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.feng",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.feng",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.integer.feng",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.feng",
          "match": "\\b(?:true|false|nil)\\b"
        }
      ]
    },
    "attributes": {
      "name": "entity.name.tag.attribute.feng",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.declaration.feng",
          "match": "\\b(?:struct|union|enum|attribute|interface|class|func|macro)\\b"
        },
        {
          "name": "keyword.control.feng",
          "match": "\\b(?:return|if|else|for|continue|break|switch|case|default|throw|try|catch|assert|this|super)\\b"
        },
        {
          "name": "keyword.other.feng",
          "match": "\\b(?:export|import|new|sizeof|final|static|const|var|let)\\b"
        }
      ]
    },
    "storage-types": {
      "name": "storage.type.feng",
      "match": "\\b(?:byte|int8|int16|int32|int64|int|uint8|uint16|uint32|uint64|uint|float32|float64|float|bool|size|string)\\b"
    },
    "operators": {
      "name": "keyword.operator.feng",
      "match": "&&=|\\|\\|=|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|~=|<-|->|==|!=|<=|>=|&&|\\|\\||<<|>>|:=|[+\\-*/%^&|~<>=!]"
    }
  }
}

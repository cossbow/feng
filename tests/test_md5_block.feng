import std$encoding;

const K [64]uint32 = [
    3614090360,3905402710,606105819,3250441966,4118548399,1200080426,2821735955,4249261313,
    1770035416,2336552879,4294925233,2304563134,1804603682,4254626195,2792965006,1236535329,
    4129170786,3225465664,643717713,3921069994,3593408605,38016083,3634488961,3889429448,
    568446438,3275163606,4107603335,1163531501,2850285829,4243563512,1735328473,2368359562,
    4294588738,2272397833,1839030562,4259657740,2763975236,1272893353,4139469664,3200236656,
    681279174,3936430074,3572445317,76029189,3654602809,3873151461,530742520,3299628645,
    4096336452,1126891415,2878612391,4237533241,1700485571,2399980690,4293915773,2240044497,
    1873313359,4264355552,2734768916,1309151649,4149444226,3174756917,718787259,3951481745,
];

const S [64]int = [
    7,12,17,22,7,12,17,22,7,12,17,22,7,12,17,22,
    5,9,14,20,5,9,14,20,5,9,14,20,5,9,14,20,
    4,11,16,23,4,11,16,23,4,11,16,23,4,11,16,23,
    6,10,15,21,6,10,15,21,6,10,15,21,6,10,15,21,
];

func main(args [&#][*#]byte) {
    var block [64]byte;
    block[0] = 128;

    var X [16]uint32;
    for (var i = 0; i < 16; i += 1) {
        var w [4]byte;
        var off = i * 4;
        w[0] = block[off]; w[1] = block[off+1]; w[2] = block[off+2]; w[3] = block[off+3];
        X[i] = encoding$littleUint32(w);
    }
    assert(X[0] == 128);

    var a uint32 = 1732584193;
    var b uint32 = 4023233417;
    var c uint32 = 2562383102;
    var d uint32 = 271733878;

    // 64 rounds with correct algorithm
    for (var i = 0; i < 64; i += 1) {
        var g int;
        if (i < 16) { g = i; }
        else if (i < 32) { g = (5 * i + 1) % 16; }
        else if (i < 48) { g = (3 * i + 5) % 16; }
        else { g = (7 * i) % 16; }

        var fv uint32;
        if (i < 16) {
            if (i % 4 == 0) { fv = (b & c) | ((!b) & d); }
            else if (i % 4 == 1) { fv = (a & b) | ((!a) & c); }
            else if (i % 4 == 2) { fv = (d & a) | ((!d) & b); }
            else { fv = (c & d) | ((!c) & a); }
        } else if (i < 32) {
            if (i % 4 == 0) { fv = (b & d) | (c & (!d)); }
            else if (i % 4 == 1) { fv = (a & c) | (b & (!c)); }
            else if (i % 4 == 2) { fv = (d & b) | (a & (!b)); }
            else { fv = (c & a) | (d & (!a)); }
        } else if (i < 48) {
            if (i % 4 == 0) { fv = b ~ c ~ d; }
            else if (i % 4 == 1) { fv = a ~ b ~ c; }
            else if (i % 4 == 2) { fv = d ~ a ~ b; }
            else { fv = c ~ d ~ a; }
        } else {
            if (i % 4 == 0) { fv = c ~ (b | (!d)); }
            else if (i % 4 == 1) { fv = b ~ (a | (!c)); }
            else if (i % 4 == 2) { fv = a ~ (d | (!b)); }
            else { fv = d ~ (c | (!a)); }
        }

        if (i % 4 == 0) {
            var t = a + fv + X[g] + K[i];
            a = b + ((t << S[i]) | (t >> (32 - S[i])));
        } else if (i % 4 == 1) {
            var t = d + fv + X[g] + K[i];
            d = a + ((t << S[i]) | (t >> (32 - S[i])));
        } else if (i % 4 == 2) {
            var t = c + fv + X[g] + K[i];
            c = d + ((t << S[i]) | (t >> (32 - S[i])));
        } else {
            var t = b + fv + X[g] + K[i];
            b = c + ((t << S[i]) | (t >> (32 - S[i])));
        }
    }

    // Confirm all 64 rounds completed without crash
    assert(a != 1732584193);  // state must have changed
}

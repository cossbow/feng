import std$testing;
import std$container c;

// ===== helper =====

func intHash(n &#c$Node`int,c$Void`) int {
    return n.key;
}
func intEq(a,b &#c$Node`int,c$Void`) bool {
    return a.key == b.key;
}
const hashing c$Hashing`int,c$Void` = {
    hash = intHash,
    equal = intEq
};

// =====================================================
// Vector tests
// =====================================================

@Test
func testVectorAppend() {
    var v = c$newVector`int`();
    v.append(10);
    v.append(20);
    v.append(30);
    testing$assertTrue(v.length() == 3);
    testing$assertTrue(v.get(0) == 10);
    testing$assertTrue(v.get(1) == 20);
    testing$assertTrue(v.get(2) == 30);
}

@Test
func testVectorAppendAll() {
    var v = c$newVector`int`();
    var src [3]int = [1, 2, 3];
    v.appendAll(src);
    testing$assertTrue(v.length() == 3);
    testing$assertTrue(v.get(0) == 1);
}

@Test
func testVectorGetSet() {
    var v = c$newVector`int`();
    v.append(5);
    v.set(0, 99);
    testing$assertTrue(v.get(0) == 99);
}

@Test
func testVectorInsert() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(3);
    v.insert(1, 2);
    testing$assertTrue(v.length() == 3);
    testing$assertTrue(v.get(0) == 1);
    testing$assertTrue(v.get(1) == 2);
    testing$assertTrue(v.get(2) == 3);
}

@Test
func testVectorInsertAtEnd() {
    var v = c$newVector`int`();
    v.append(1);
    v.insert(1, 2);
    testing$assertTrue(v.length() == 2);
    testing$assertTrue(v.get(1) == 2);
}

@Test
func testVectorRemoveAt() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    v.append(3);
    var removed = v.removeAt(1);
    testing$assertTrue(removed == 2);
    testing$assertTrue(v.length() == 2);
    testing$assertTrue(v.get(0) == 1);
    testing$assertTrue(v.get(1) == 3);
}

@Test
func testVectorRemoveLast() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    var last = v.removeLast();
    testing$assertTrue(last == 2);
    testing$assertTrue(v.length() == 1);
    testing$assertTrue(v.get(0) == 1);
}

@Test
func testVectorIndexOf() {
    var v = c$newVector`int`();
    v.append(10);
    v.append(20);
    v.append(10);
    testing$assertTrue(v.indexOf(10) == 0);
    testing$assertTrue(v.indexOf(20) == 1);
    testing$assertTrue(v.indexOf(99) == -1);
}

@Test
func testVectorLastIndexOf() {
    var v = c$newVector`int`();
    v.append(10);
    v.append(20);
    v.append(10);
    testing$assertTrue(v.lastIndexOf(10) == 2);
    testing$assertTrue(v.lastIndexOf(99) == -1);
}

@Test
func testVectorContains() {
    var v = c$newVector`int`();
    v.append(42);
    testing$assertTrue(v.contains(42));
    testing$assertFalse(v.contains(99));
}

@Test
func testVectorReverse() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    v.append(3);
    v.reverse();
    testing$assertTrue(v.get(0) == 3);
    testing$assertTrue(v.get(1) == 2);
    testing$assertTrue(v.get(2) == 1);
}

@Test
func testVectorClear() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    v.clear();
    testing$assertTrue(v.length() == 0);
    testing$assertTrue(v.isEmpty());
}

@Test
func testVectorTruncate() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    v.append(3);
    v.truncate(1);
    testing$assertTrue(v.length() == 1);
    testing$assertTrue(v.get(0) == 1);
}

@Test
func testVectorTruncateNoGrow() {
    var v = c$newVector`int`();
    v.append(1);
    v.truncate(5);
    testing$assertTrue(v.length() == 1);
}

@Test
func testVectorIsEmpty() {
    var v = c$newVector`int`();
    testing$assertTrue(v.isEmpty());
    v.append(1);
    testing$assertFalse(v.isEmpty());
}

@Test
func testVectorCapacity() {
    var v = c$newVector`int`();
    testing$assertTrue(v.capacity() == 0);
    v.append(1);
    testing$assertTrue(v.capacity() >= 1);
}

@Test
func testVectorGrow() {
    var v = c$newVector`int`();
    for (var i = 0; i < 100; i += 1) {
        v.append(i);
    }
    testing$assertTrue(v.length() == 100);
    testing$assertTrue(v.get(0) == 0);
    testing$assertTrue(v.get(99) == 99);
}

@Test
func testVectorCopyTo() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    v.append(3);
    var dst [3]int;
    var n = v.copyTo(dst);
    testing$assertTrue(n == 3);
    testing$assertTrue(dst[0] == 1);
    testing$assertTrue(dst[1] == 2);
    testing$assertTrue(dst[2] == 3);
}

@Test
func testVectorCopyToSmall() {
    var v = c$newVector`int`();
    v.append(1);
    v.append(2);
    v.append(3);
    var dst [2]int;
    var n = v.copyTo(dst);
    testing$assertTrue(n == 2);
    testing$assertTrue(dst[0] == 1);
    testing$assertTrue(dst[1] == 2);
}

@Test
func testVectorFromArray() {
    var src [3]int = [4, 5, 6];
    var v = c$vectorFromArray`int`(src);
    testing$assertTrue(v.length() == 3);
    testing$assertTrue(v.get(0) == 4);
}

@Test
func testVectorNewCap() {
    var v = c$newVectorCap`int`(32);
    testing$assertTrue(v.capacity() >= 32);
    testing$assertTrue(v.length() == 0);
}

// =====================================================
// Stack tests
// =====================================================

@Test
func testStackPushPop() {
    var s = c$newStack`int`();
    s.push(10);
    s.push(20);
    s.push(30);
    testing$assertTrue(s.pop() == 30);
    testing$assertTrue(s.pop() == 20);
    testing$assertTrue(s.pop() == 10);
    testing$assertTrue(s.isEmpty());
}

@Test
func testStackPeek() {
    var s = c$newStack`int`();
    s.push(42);
    testing$assertTrue(s.peek() == 42);
    testing$assertTrue(s.size() == 1);
}

@Test
func testStackSize() {
    var s = c$newStack`int`();
    testing$assertTrue(s.size() == 0);
    s.push(1);
    s.push(2);
    testing$assertTrue(s.size() == 2);
    s.pop();
    testing$assertTrue(s.size() == 1);
}

@Test
func testStackIsEmpty() {
    var s = c$newStack`int`();
    testing$assertTrue(s.isEmpty());
    s.push(1);
    testing$assertFalse(s.isEmpty());
}

@Test
func testStackClear() {
    var s = c$newStack`int`();
    s.push(1);
    s.push(2);
    s.clear();
    testing$assertTrue(s.isEmpty());
    testing$assertTrue(s.size() == 0);
}

// =====================================================
// BitSet tests
// =====================================================

@Test
func testBitSetSetGet() {
    var bs = c$newBitSet();
    bs.set(0);
    bs.set(5);
    bs.set(31);
    testing$assertTrue(bs.get(0));
    testing$assertTrue(bs.get(5));
    testing$assertTrue(bs.get(31));
    testing$assertFalse(bs.get(1));
    testing$assertFalse(bs.get(32));
}

@Test
func testBitSetClear() {
    var bs = c$newBitSet();
    bs.set(10);
    testing$assertTrue(bs.get(10));
    bs.clear(10);
    testing$assertFalse(bs.get(10));
}

@Test
func testBitSetClearOutOfRange() {
    var bs = c$newBitSet();
    bs.clear(100);
    testing$assertFalse(bs.get(100));
}

@Test
func testBitSetToggle() {
    var bs = c$newBitSet();
    bs.toggle(0);
    testing$assertTrue(bs.get(0));
    bs.toggle(0);
    testing$assertFalse(bs.get(0));
}

@Test
func testBitSetAutoGrow() {
    var bs = c$newBitSet();
    bs.set(99);
    testing$assertTrue(bs.get(99));
    testing$assertTrue(bs.cap() >= 100);
}

@Test
func testBitSetGetOutOfRange() {
    var bs = c$newBitSet();
    testing$assertFalse(bs.get(999));
}

@Test
func testBitSetCount() {
    var bs = c$newBitSet();
    testing$assertTrue(bs.count() == 0);
    bs.set(0);
    bs.set(3);
    bs.set(7);
    testing$assertTrue(bs.count() == 3);
}

@Test
func testBitSetIsEmpty() {
    var bs = c$newBitSet();
    testing$assertTrue(bs.isEmpty());
    bs.set(0);
    testing$assertFalse(bs.isEmpty());
}

@Test
func testBitSetClearAll() {
    var bs = c$newBitSet();
    bs.set(0);
    bs.set(5);
    bs.set(10);
    bs.clearAll();
    testing$assertTrue(bs.isEmpty());
    testing$assertFalse(bs.get(0));
    testing$assertFalse(bs.get(5));
}

@Test
func testBitSetAnd() {
    var a = c$newBitSet();
    var b = c$newBitSet();
    a.set(0);
    a.set(2);
    b.set(0);
    b.set(3);
    a.and(b);
    testing$assertTrue(a.get(0));
    testing$assertFalse(a.get(2));
    testing$assertFalse(a.get(3));
}

@Test
func testBitSetOr() {
    var a = c$newBitSet();
    var b = c$newBitSet();
    a.set(0);
    a.set(2);
    b.set(1);
    b.set(3);
    a.or(b);
    testing$assertTrue(a.get(0));
    testing$assertTrue(a.get(1));
    testing$assertTrue(a.get(2));
    testing$assertTrue(a.get(3));
}

@Test
func testBitSetOrGrow() {
    var a = c$newBitSet();
    var b = c$newBitSet();
    b.set(100);
    a.or(b);
    testing$assertTrue(a.get(100));
}

@Test
func testBitSetXor() {
    var a = c$newBitSet();
    var b = c$newBitSet();
    a.set(0);
    a.set(1);
    b.set(1);
    b.set(2);
    a.xor(b);
    testing$assertTrue(a.get(0));
    testing$assertFalse(a.get(1));
    testing$assertTrue(a.get(2));
}

@Test
func testBitSetAndNot() {
    var a = c$newBitSet();
    var b = c$newBitSet();
    a.set(0);
    a.set(1);
    b.set(1);
    a.andNot(b);
    testing$assertTrue(a.get(0));
    testing$assertFalse(a.get(1));
}

@Test
func testBitSetNewCap() {
    var bs = c$newBitSetCap(64);
    testing$assertTrue(bs.cap() >= 64);
}

@Test
func testBitSetAndNil() {
    var bs = c$newBitSet();
    bs.set(0);
    bs.and(nil);
    testing$assertTrue(bs.get(0));
}

// =====================================================
// Deque tests
// =====================================================

@Test
func testDequePushBackPopFront() {
    var d = c$newDeque`int`();
    d.pushBack(1);
    d.pushBack(2);
    d.pushBack(3);
    testing$assertTrue(d.popFront() == 1);
    testing$assertTrue(d.popFront() == 2);
    testing$assertTrue(d.popFront() == 3);
    testing$assertTrue(d.isEmpty());
}

@Test
func testDequePushFrontPopBack() {
    var d = c$newDeque`int`();
    d.pushFront(1);
    d.pushFront(2);
    d.pushFront(3);
    testing$assertTrue(d.popBack() == 1);
    testing$assertTrue(d.popBack() == 2);
    testing$assertTrue(d.popBack() == 3);
}

@Test
func testDequePushBackPopBack() {
    var d = c$newDeque`int`();
    d.pushBack(1);
    d.pushBack(2);
    testing$assertTrue(d.popBack() == 2);
    testing$assertTrue(d.popBack() == 1);
}

@Test
func testDequePushFrontPopFront() {
    var d = c$newDeque`int`();
    d.pushFront(1);
    d.pushFront(2);
    testing$assertTrue(d.popFront() == 2);
    testing$assertTrue(d.popFront() == 1);
}

@Test
func testDequePeekFront() {
    var d = c$newDeque`int`();
    d.pushBack(42);
    testing$assertTrue(d.peekFront() == 42);
    testing$assertTrue(d.length() == 1);
}

@Test
func testDequePeekBack() {
    var d = c$newDeque`int`();
    d.pushBack(10);
    d.pushBack(20);
    testing$assertTrue(d.peekBack() == 20);
    testing$assertTrue(d.length() == 2);
}

@Test
func testDequeLength() {
    var d = c$newDeque`int`();
    testing$assertTrue(d.length() == 0);
    d.pushBack(1);
    d.pushFront(2);
    testing$assertTrue(d.length() == 2);
    d.popFront();
    testing$assertTrue(d.length() == 1);
}

@Test
func testDequeIsEmpty() {
    var d = c$newDeque`int`();
    testing$assertTrue(d.isEmpty());
    d.pushBack(1);
    testing$assertFalse(d.isEmpty());
}

@Test
func testDequeClear() {
    var d = c$newDeque`int`();
    d.pushBack(1);
    d.pushBack(2);
    d.clear();
    testing$assertTrue(d.isEmpty());
    testing$assertTrue(d.length() == 0);
}

@Test
func testDequeGrow() {
    var d = c$newDeque`int`();
    for (var i = 0; i < 100; i += 1) {
        d.pushBack(i);
    }
    testing$assertTrue(d.length() == 100);
    testing$assertTrue(d.peekFront() == 0);
    testing$assertTrue(d.peekBack() == 99);
}

@Test
func testDequeWrapAround() {
    var d = c$newDeque`int`();
    for (var i = 0; i < 20; i += 1) {
        d.pushBack(i);
    }
    for (var i = 0; i < 10; i += 1) {
        d.popFront();
    }
    for (var i = 100; i < 110; i += 1) {
        d.pushBack(i);
    }
    testing$assertTrue(d.length() == 20);
    testing$assertTrue(d.peekFront() == 10);
    testing$assertTrue(d.peekBack() == 109);
}

@Test
func testDequeMixed() {
    var d = c$newDeque`int`();
    d.pushBack(1);
    d.pushFront(2);
    d.pushBack(3);
    d.pushFront(4);
    testing$assertTrue(d.popFront() == 4);
    testing$assertTrue(d.popBack() == 3);
    testing$assertTrue(d.popFront() == 2);
    testing$assertTrue(d.popBack() == 1);
}

@Test
func testDequeNewCap() {
    var d = c$newDequeCap`int`(64);
    testing$assertTrue(d.isEmpty());
    d.pushBack(1);
    testing$assertTrue(d.length() == 1);
}

// =====================================================
// HashSet tests
// =====================================================

@Test
func testHashSetAdd() {
    var s = c$newSet`int`(hashing);
    testing$assertTrue(s.add(1));
    testing$assertTrue(s.add(2));
    testing$assertFalse(s.add(1));
    testing$assertTrue(s.size() == 2);
}

@Test
func testHashSetContains() {
    var s = c$newSet`int`(hashing);
    s.add(10);
    s.add(20);
    testing$assertTrue(s.contains(10));
    testing$assertTrue(s.contains(20));
    testing$assertFalse(s.contains(30));
}

@Test
func testHashSetContainsEmpty() {
    var s = c$newSet`int`(hashing);
    testing$assertFalse(s.contains(1));
}

@Test
func testHashSetRemove() {
    var s = c$newSet`int`(hashing);
    s.add(1);
    s.add(2);
    s.add(3);
    testing$assertTrue(s.remove(2));
    testing$assertFalse(s.remove(2));
    testing$assertTrue(s.size() == 2);
    testing$assertTrue(s.contains(1));
    testing$assertFalse(s.contains(2));
    testing$assertTrue(s.contains(3));
}

@Test
func testHashSetRemoveHead() {
    var s = c$newSet`int`(hashing);
    s.add(0);
    s.add(16);
    s.add(32);
    testing$assertTrue(s.remove(0));
    testing$assertFalse(s.contains(0));
    testing$assertTrue(s.contains(16));
    testing$assertTrue(s.contains(32));
}

@Test
func testHashSetRemoveMiddle() {
    var s = c$newSet`int`(hashing);
    s.add(0);
    s.add(16);
    s.add(32);
    testing$assertTrue(s.remove(16));
    testing$assertTrue(s.contains(0));
    testing$assertFalse(s.contains(16));
    testing$assertTrue(s.contains(32));
}

@Test
func testHashSetRemoveLast() {
    var s = c$newSet`int`(hashing);
    s.add(0);
    s.add(16);
    s.add(32);
    testing$assertTrue(s.remove(32));
    testing$assertTrue(s.contains(0));
    testing$assertTrue(s.contains(16));
    testing$assertFalse(s.contains(32));
}

@Test
func testHashSetRemoveFromEmpty() {
    var s = c$newSet`int`(hashing);
    testing$assertFalse(s.remove(1));
}

@Test
func testHashSetLength() {
    var s = c$newSet`int`(hashing);
    testing$assertTrue(s.size() == 0);
    s.add(1);
    testing$assertTrue(s.size() == 1);
    s.add(1);
    testing$assertTrue(s.size() == 1);
}

@Test
func testHashSetIsEmpty() {
    var s = c$newSet`int`(hashing);
    testing$assertTrue(s.isEmpty());
    s.add(1);
    testing$assertFalse(s.isEmpty());
}

@Test
func testHashSetClear() {
    var s = c$newSet`int`(hashing);
    s.add(1);
    s.add(2);
    s.clear();
    testing$assertTrue(s.isEmpty());
    testing$assertTrue(s.size() == 0);
    testing$assertFalse(s.contains(1));
}

@Test
func testHashSetRehash() {
    var s = c$newSet`int`(hashing);
    for (var i = 0; i < 100; i += 1) {
        s.add(i);
    }
    testing$assertTrue(s.size() == 100);
    for (var i = 0; i < 100; i += 1) {
        testing$assertTrue(s.contains(i));
    }
}



import std$testing;
import std$container c;

func cmpMin(a, b int) int {
    if (a < b) { return -1; }
    if (a > b) { return 1; }
    return 0;
}

func cmpMax(a, b int) int {
    if (a > b) { return -1; }
    if (a < b) { return 1; }
    return 0;
}

// ===== min-heap =====

@Test
func testMinHeapPushPop() {
    var h = c$newHeap`int`(cmpMin);
    h.push(3);
    h.push(1);
    h.push(2);
    testing$assertTrue(h.length() == 3);
    testing$assertTrue(h.pop() == 1);
    testing$assertTrue(h.pop() == 2);
    testing$assertTrue(h.pop() == 3);
}

@Test
func testMinHeapPeek() {
    var h = c$newHeap`int`(cmpMin);
    h.push(5);
    h.push(2);
    testing$assertTrue(h.peek() == 2);
    testing$assertTrue(h.length() == 2);
}

@Test
func testMinHeapEmpty() {
    var h = c$newHeap`int`(cmpMin);
    testing$assertTrue(h.isEmpty());
    testing$assertTrue(h.length() == 0);
}

@Test
func testMinHeapClear() {
    var h = c$newHeap`int`(cmpMin);
    h.push(1);
    h.push(2);
    h.clear();
    testing$assertTrue(h.isEmpty());
    testing$assertTrue(h.length() == 0);
}

@Test
func testMinHeapLarge() {
    var h = c$newHeap`int`(cmpMin);
    // Push 1..100 in reverse order
    for (var i = 100; i >= 1; i -= 1) {
        h.push(i);
    }
    testing$assertTrue(h.length() == 100);
    for (var i = 1; i <= 100; i += 1) {
        testing$assertTrue(h.pop() == i);
    }
}

@Test
func testMinHeapDuplicates() {
    var h = c$newHeap`int`(cmpMin);
    h.push(2);
    h.push(2);
    h.push(1);
    h.push(3);
    testing$assertTrue(h.pop() == 1);
    testing$assertTrue(h.pop() == 2);
    testing$assertTrue(h.pop() == 2);
    testing$assertTrue(h.pop() == 3);
}

// ===== max-heap =====

@Test
func testMaxHeapPushPop() {
    var h = c$newHeap`int`(cmpMax);
    h.push(1);
    h.push(3);
    h.push(2);
    testing$assertTrue(h.pop() == 3);
    testing$assertTrue(h.pop() == 2);
    testing$assertTrue(h.pop() == 1);
}

@Test
func testMaxHeapLarge() {
    var h = c$newHeap`int`(cmpMax);
    for (var i = 1; i <= 50; i += 1) {
        h.push(i);
    }
    for (var i = 50; i >= 1; i -= 1) {
        testing$assertTrue(h.pop() == i);
    }
}

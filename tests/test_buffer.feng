import std$testing;
import std$bytes;

@Test
func testBufferWriterWrite() {
    var bw = bytes$newWriter();
    var data = "Hello, Buffer!";
    var n = bw.write(data, 0, data.length);
}

@Test
func testBufferWriterWriteByte() {
    var bw = bytes$newWriter();
    bw.writeByte(65);  // 'A'
    bw.writeByte(66);  // 'B'
    bw.writeByte(67);  // 'C'
    var buf = bw.get();
    var bl = buf.1;
}

@Test
func testBufferWriterLength() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    var len = bw.length();
    testing$assertTrue(len == 1);
    testing$assertFalse(bw.isEmpty());
}

@Test
func testBufferWriterClear() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    bw.clear();
    testing$assertTrue(bw.isEmpty());
    testing$assertTrue(bw.length() == 0);
}

@Test
func testBufferWriterCopy() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    bw.writeByte(66);
    var copied = bw.copy();
    var bl = copied.length;
}

@Test
func testBufferWriterGet() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    var t = bw.get();
    var buf = t.0;
    var len = t.1;
}

@Test
func testBufferWriterReader() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    bw.writeByte(66);
    var br = bw.reader();
    var out = new([2]byte);
    var n = br.read(out);
}

@Test
func testBufferReaderRead() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    bw.writeByte(66);
    bw.writeByte(67);
    var br = bw.reader();

    var buf1 = new([1]byte);
    var n1 = br.read(buf1);

    var buf2 = new([2]byte);
    var n2 = br.read(buf2);
}

@Test
func testBufferReaderSeek() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    bw.writeByte(66);
    bw.writeByte(67);
    var br = bw.reader();

    br.seek(1);
    var rem = br.remaining();

    var buf = new([2]byte);
    var n = br.read(buf);
}

@Test
func testBufferReaderRemaining() {
    var bw = bytes$newWriter();
    bw.writeByte(65);
    bw.writeByte(66);
    var br = bw.reader();
    var rem = br.remaining();
    var ie = br.isEmpty();

    var buf = new([2]byte);
    br.read(buf);
    var rem2 = br.remaining();
    var ie2 = br.isEmpty();
}

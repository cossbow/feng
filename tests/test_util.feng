import std$testing;
import std$util;

@Test
func testCopy() {
    var src [5]int = [1, 2, 3, 4, 5];
    var dst [5]int;
    util$copy`int`(src, dst, 5);
}

@Test
func testEqual() {
    var a [3]int = [1, 2, 3];
    var b [3]int = [1, 2, 3];
    var c [3]int = [1, 2, 4];
    testing$assertTrue(util$equal`int`(a, b));
    testing$assertFalse(util$equal`int`(a, c));

    // different lengths
    var d [4]int = [1, 2, 3, 4];
    testing$assertFalse(util$equal`int`(a, d));
}

@Test
func testFill() {
    var arr [5]int;
    util$fill`int`(arr, 42);
    testing$assertTrue(arr[0] == 42);
}

@Test
func testReverse() {
    var arr [4]int = [1, 2, 3, 4];
    util$reverse`int`(arr);
    testing$assertTrue(arr[0] == 4);

    // single element
    var s [1]int = [5];
    util$reverse`int`(s);
    testing$assertTrue(s[0] == 5);
}

@Test
func testIndexOf() {
    var arr [5]int = [10, 20, 30, 20, 50];
    testing$assertTrue(util$indexOf`int`(arr, 30) == 2);
    testing$assertTrue(util$indexOf`int`(arr, 20) == 1);
    testing$assertTrue(util$indexOf`int`(arr, 99) == -1);
}

@Test
func testContains() {
    var arr [3]int = [1, 2, 3];
    testing$assertTrue(util$contains`int`(arr, 2));
    testing$assertFalse(util$contains`int`(arr, 99));
}

@Test
func testCopyByteSlice() {
    var src = "hello";
    var dst = new([5]byte);
    util$copy`byte`(src, dst, 5);
}

import std$testing;
import std$string;
import std$error;

@Test
func testString() {
    var s = string$fromUtf8("Hello");
    testing$assertTrue(s.byteLength() == 5);
    testing$assertTrue(s.runeCount() == 5);
    testing$assertFalse(s.isEmpty());
}

@Test
func testCompare() {
    var a = string$fromUtf8("abc");
    var b = string$fromUtf8("abc");
    var c = string$fromUtf8("abd");
    testing$assertTrue(a.compare(b) == 0);
    testing$assertTrue(a.compare(c) < 0);
    testing$assertTrue(a.equals(b));
    testing$assertFalse(a.equals(c));
}

@Test
func testConcat() {
    var a = string$fromUtf8("Hello");
    var b = string$fromUtf8(" World");
    var c = a.concat(b);
    testing$assertTrue(c.byteLength() == 11);
}

@Test
func testIndexOf() {
    var s = string$fromUtf8("Hello, World!");
    var i1 = s.indexOf(87);  // 'W' = 87
    testing$assertTrue(i1 == 7);
    var i2 = s.indexOfStr(string$fromUtf8("World"));
    testing$assertTrue(i2 == 7);
    var c = s.contains(string$fromUtf8("World"));
    testing$assertTrue(c);
}

@Test
func testPrefixSuffix() {
    var s = string$fromUtf8("Hello, World!");
    testing$assertTrue(s.startsWith(string$fromUtf8("Hello")));
    testing$assertTrue(s.endsWith(string$fromUtf8("World!")));
}

@Test
func testSubstring() {
    var s = string$fromUtf8("Hello, World!");
    var sub = s.substring(7, 12);
    testing$assertTrue(sub.byteLength() == 5);
}

@Test
func testRune() {
    var s = string$fromUtf8("你好世界");
    var r0 = s.rune(0);
    testing$assertTrue(r0 != 0);  // valid rune
    testing$assertTrue(s.runeCount() == 4);
}

@Test
func testEmpty() {
    var e = string$EMPTY;
    testing$assertTrue(e.isEmpty());
}

@Test
func testSplit() {
    var s = string$fromUtf8("a,b,c");
    var parts = s.split(string$fromUtf8(","));
    // parts should have 3 elements: "a", "b", "c"
    var p0 = parts[0];
    var p1 = parts[1];
    var p2 = parts[2];

    // empty separator: returns entire string
    var s2 = string$fromUtf8("hello");
    var parts2 = s2.split(string$EMPTY);
}

@Test
func testSplitEmpty() {
    var s = string$fromUtf8("");
    var parts = s.split(string$fromUtf8(","));
}

@Test
func testJoin() {
    var parts = new([3]string$String);
    parts[0] = string$fromUtf8("a");
    parts[1] = string$fromUtf8("b");
    parts[2] = string$fromUtf8("c");
    var joined = string$join(parts, string$fromUtf8(","));

    // join empty
    var empty = new([0]string$String);
    var e = string$join(empty, string$fromUtf8(","));

    // single element
    var single = new([1]string$String);
    single[0] = string$fromUtf8("only");
    var s = string$join(single, string$fromUtf8(","));
}

@Test
func testReplace() {
    var s = string$fromUtf8("hello world hello");
    var r = s.replace(string$fromUtf8("hello"), string$fromUtf8("hi"));
    testing$assertTrue(r.byteLength() > 0);

    // replace with empty -> remove all
    var r2 = s.replace(string$fromUtf8("hello"), string$EMPTY);

    // no match
    var r3 = s.replace(string$fromUtf8("xyz"), string$fromUtf8("abc"));
}

@Test
func testTrim() {
    var s1 = string$fromUtf8("  hello  ");
    var t1 = s1.trim();

    var s2 = string$fromUtf8("\t\n  world  \r\n");
    var t2 = s2.trim();

    // already trimmed
    var s3 = string$fromUtf8("abc");
    var t3 = s3.trim();

    // all whitespace
    var s4 = string$fromUtf8("   ");
    var t4 = s4.trim();
}

@Test
func testToLower() {
    var s = string$fromUtf8("Hello, WORLD!");
    var lower = s.toLower();
}

@Test
func testToUpper() {
    var s = string$fromUtf8("Hello, world!");
    var upper = s.toUpper();
}

@Test
func testRuneException() {
    var s = string$fromUtf8("你好");
    try {
        s.rune(10);  // out of bounds
    } catch(e *!#OutOfBoundsException) {
        // expected
    }
}

@Test
func testSubstringException() {
    var s = string$fromUtf8("hello");
    try {
        s.substring(5, 2);  // start > end
    } catch(e *!#error$IllegalArgumentException) {
        // expected
    }
}


@Test
func testBuilder() {
    var sb = string$newBuilder();
    sb.append(string$fromUtf8("Hello"));
    sb.append(string$fromUtf8(" "));
    sb.append(string$fromUtf8("World"));
    var s = sb.build();
    testing$assertTrue(s.byteLength() == 11);
}

@Test
func testAppendInt() {
    var sb = string$newBuilder();
    sb.appendInt(42);
    sb.append(string$fromUtf8(" "));
    sb.appendInt(-100);
    var s = sb.build();
    testing$assertTrue(s.byteLength() > 0);
}

@Test
func testAppendBool() {
    var sb = string$newBuilder();
    sb.appendBool(true);
    sb.append(string$fromUtf8(" "));
    sb.appendBool(false);
    var s = sb.build();
    testing$assertTrue(s.byteLength() > 0);
}

@Test
func testAppendInt64() {
    var sb = string$newBuilder();
    sb.appendInt64(int64(1234567890123));
    var s = sb.build();
}

@Test
func testAppendUint() {
    var sb = string$newBuilder();
    sb.appendUint(uint(42));
    var s = sb.build();
}

@Test
func testAppendBytes() {
    var sb = string$newBuilder();
    sb.appendBytes("raw bytes");
    var s = sb.build();
    testing$assertTrue(s.byteLength() > 0);
}

@Test
func testAppendByte() {
    var sb = string$newBuilder();
    sb.appendByte(65);  // 'A'
    sb.appendByte(66);  // 'B'
    var s = sb.build();
    testing$assertTrue(s.byteLength() > 0);
}

@Test
func testAppendRune() {
    var sb = string$newBuilder();
    sb.appendRune(int32(20320));  // 你
    var s = sb.build();
}

@Test
func testAppendFloat() {
    var sb = string$newBuilder();
    sb.appendFloat(3.14);
    var s = sb.build();
}

@Test
func testClear() {
    var sb = string$newBuilder();
    sb.append(string$fromUtf8("hello"));
    sb.clear();
    testing$assertTrue(sb.isEmpty());
    var s = sb.build();
}

@Test
func testLength() {
    var sb = string$newBuilder();
    sb.append(string$fromUtf8("hi"));
    testing$assertTrue(sb.length() == 2);

    var sb2 = string$newBuilder();
    testing$assertTrue(sb2.isEmpty());
}

@Test
func testCapacity() {
    var sb = string$newBuilderCapacity(100);
    sb.append(string$fromUtf8("test"));
    var s = sb.build();
}

import std$testing;
import std$error;

// NOTE: This test requires --debug flag to enable assert statements

@Test
func testAssertPass() {
    assert(5 > 0);
    // should pass without exception
}

@Test
func testAssertFail() {
    try {
        assert(1 < 0);  // deliberately false
    } catch(e *!#AssertException) {
        // expected
    }
}

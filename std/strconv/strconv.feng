
import std$error;

// Parse a signed integer from byte sequence.
// Returns (value, ok). ok is false if parsing fails.
export func parseInt(s [&!#]byte) (int, bool) {
    if (s.length == 0) { return (0, false); }
    var i = 0;
    var neg = false;
    var v = s[0];
    if (v == 45) {         // '-'
        neg = true;
        i = 1;
    } else if (v == 43) {  // '+'
        i = 1;
    }
    if (i >= s.length) { return (0, false); }

    var result = 0;
    for (i < s.length) {
        var c = int(s[i]);
        if (c < 48 || c > 57) { return (0, false); }  // '0'=48, '9'=57
        result = result * 10 + (c - 48);
        i += 1;
    }
    if (neg) { result = -result; }
    return (result, true);
}

// Parse a 64-bit signed integer from byte sequence.
export func parseInt64(s [&!#]byte) (int64, bool) {
    if (s.length == 0) { return (0, false); }
    var i = 0;
    var neg = false;
    var v = s[0];
    if (v == 45) {
        neg = true;
        i = 1;
    } else if (v == 43) {
        i = 1;
    }
    if (i >= s.length) { return (0, false); }

    var result int64 = 0;
    for (i < s.length) {
        var c = int(s[i]);
        if (c < 48 || c > 57) { return (0, false); }
        result = result * 10 + int64(c - 48);
        i += 1;
    }
    if (neg) { result = -result; }
    return (result, true);
}

// Parse an unsigned integer from byte sequence.
export func parseUint(s [&!#]byte) (uint, bool) {
    if (s.length == 0) { return (0, false); }
    var i = 0;
    var v = s[0];
    if (v == 43) {  // '+'
        i = 1;
    }
    if (i >= s.length) { return (0, false); }

    var result uint = 0;
    for (i < s.length) {
        var c = uint(s[i]);
        if (c < 48 || c > 57) { return (0, false); }
        result = result * 10 + (c - 48);
        i += 1;
    }
    return (result, true);
}

// Parse a 64-bit unsigned integer from byte sequence.
export func parseUint64(s [&!#]byte) (uint64, bool) {
    if (s.length == 0) { return (0, false); }
    var i = 0;
    var v = s[0];
    if (v == 43) {
        i = 1;
    }
    if (i >= s.length) { return (0, false); }

    var result uint64 = 0;
    for (i < s.length) {
        var c = uint64(s[i]);
        if (c < 48 || c > 57) { return (0, false); }
        result = result * 10 + (c - 48);
        i += 1;
    }
    return (result, true);
}

// Parse a float64 from byte sequence.
// Supports optional sign, integer part, decimal point, and fractional part.
export func parseFloat64(s [&!#]byte) (float, bool) {
    if (s.length == 0) { return (0.0, false); }
    var i = 0;
    var neg = false;
    var v = s[0];
    if (v == 45) {         // '-'
        neg = true;
        i = 1;
    } else if (v == 43) {  // '+'
        i = 1;
    }
    if (i >= s.length) { return (0.0, false); }

    // integer part
    var intPart float = 0.0;
    var hasDigits = false;
    for (i < s.length && int(s[i]) >= 48 && int(s[i]) <= 57) {
        intPart = intPart * 10.0 + float(int(s[i]) - 48);
        hasDigits = true;
        i += 1;
    }

    // fractional part
    var fracPart float = 0.0;
    if (i < s.length && s[i] == 46) {  // '.'
        i += 1;
        var divisor float = 10.0;
        for (i < s.length && int(s[i]) >= 48 && int(s[i]) <= 57) {
            fracPart = fracPart + float(int(s[i]) - 48) / divisor;
            divisor = divisor * 10.0;
            hasDigits = true;
            i += 1;
        }
    }

    if (!hasDigits) { return (0.0, false); }
    if (i < s.length) { return (0.0, false); }  // trailing junk

    var result = intPart + fracPart;
    if (neg) { result = -result; }
    return (result, true);
}

// Parse a boolean from byte sequence.
// Accepts "true" (case-sensitive) for true, "false" (case-sensitive) for false.
export func parseBool(s [&!#]byte) (bool, bool) {
    // "true" = [116, 114, 117, 101]
    if (s.length == 4 && s[0] == 116 && s[1] == 114 && s[2] == 117 && s[3] == 101) {
        return (true, true);
    }
    // "false" = [102, 97, 108, 115, 101]
    if (s.length == 5 && s[0] == 102 && s[1] == 97 && s[2] == 108 && s[3] == 115 && s[4] == 101) {
        return (false, true);
    }
    return (false, false);
}

// ----- must* variants that throw ParseError on failure -----

export func mustParseInt(s [&!#]byte) int {
    var r = parseInt(s);
    if (!r.1) {
        throw new(error$ParseError);
    }
    return r.0;
}

export func mustParseInt64(s [&!#]byte) int64 {
    var r = parseInt64(s);
    if (!r.1) {
        throw new(error$ParseError);
    }
    return r.0;
}

export func mustParseUint(s [&!#]byte) uint {
    var r = parseUint(s);
    if (!r.1) {
        throw new(error$ParseError);
    }
    return r.0;
}

export func mustParseUint64(s [&!#]byte) uint64 {
    var r = parseUint64(s);
    if (!r.1) {
        throw new(error$ParseError);
    }
    return r.0;
}

export func mustParseFloat64(s [&!#]byte) float {
    var r = parseFloat64(s);
    if (!r.1) {
        throw new(error$ParseError);
    }
    return r.0;
}

export func mustParseBool(s [&!#]byte) bool {
    var r = parseBool(s);
    if (!r.1) {
        throw new(error$ParseError);
    }
    return r.0;
}

// ----- formatting -----

// Format an int as a decimal byte sequence.
export func formatInt(v int) [*#]byte {
    if (v == 0) { return "0"; }
    var neg = false;
    var val = v;
    if (val < 0) {
        neg = true;
        val = -val;
    }
    var buf [20]byte;
    var i = 0;
    for (val > 0) {
        buf[i] = byte(val % 10 + 48);
        val = val / 10;
        i += 1;
    }
    if (neg) {
        buf[i] = 45;  // '-'
        i += 1;
    }
    // Reverse
    var result = new([i]byte);
    for (var j = 0; j < i; j += 1) {
        result[j] = buf[i - 1 - j];
    }
    return result;
}

// Format an int64 as a decimal byte sequence.
export func formatInt64(v int64) [*#]byte {
    if (v == 0) { return "0"; }
    var neg = false;
    var val = v;
    if (val < 0) {
        neg = true;
        val = -val;
    }
    var buf [20]byte;
    var i = 0;
    for (val > 0) {
        buf[i] = byte(int(val % 10) + 48);
        val = val / 10;
        i += 1;
    }
    if (neg) {
        buf[i] = 45;
        i += 1;
    }
    // Reverse
    var result = new([i]byte);
    for (var j = 0; j < i; j += 1) {
        result[j] = buf[i - 1 - j];
    }
    return result;
}

// Format an unsigned int as a decimal byte sequence.
export func formatUint(v uint) [*#]byte {
    if (v == 0) { return "0"; }
    var buf [20]byte;
    var i = 0;
    var val = v;
    for (val > 0) {
        buf[i] = byte(int(val % 10) + 48);
        val = val / 10;
        i += 1;
    }
    // Reverse
    var result = new([i]byte);
    for (var j = 0; j < i; j += 1) {
        result[j] = buf[i - 1 - j];
    }
    return result;
}

// Format a uint64 as a decimal byte sequence.
export func formatUint64(v uint64) [*#]byte {
    if (v == 0) { return "0"; }
    var buf [20]byte;
    var i = 0;
    var val = v;
    for (val > 0) {
        buf[i] = byte(int(val % 10) + 48);
        val = val / 10;
        i += 1;
    }
    // Reverse
    var result = new([i]byte);
    for (var j = 0; j < i; j += 1) {
        result[j] = buf[i - 1 - j];
    }
    return result;
}

// Format a float64 as a decimal byte sequence.
export func formatFloat(val float) [*#]byte {
    // Handle special cases
    if (val == 0.0) {
        if (1.0 / val < 0.0) {
            return "-0.0";
        }
        return "0.0";
    }

    var neg = false;
    var v = val;
    if (v < 0.0) {
        neg = true;
        v = -v;
    }

    // Integer part
    var intPart = int(v);
    var frac = v - float(intPart);

    // Collect integer digits
    var intBuf [20]byte;
    var intLen = 0;
    if (intPart == 0) {
        intBuf[0] = 48;  // '0'
        intLen = 1;
    } else {
        var ip = intPart;
        for (ip > 0) {
            intBuf[intLen] = byte(ip % 10 + 48);
            ip = ip / 10;
            intLen += 1;
        }
    }

    // Collect fractional digits (up to 6)
    var fracBuf [7]byte;
    var fracLen = 0;
    for (var k = 0; k < 6; k += 1) {
        frac = frac * 10.0;
        var d = int(frac);
        fracBuf[k] = byte(d + 48);
        frac = frac - float(d);
        fracLen += 1;
        if (frac == 0.0) { break; }
    }

    // Build result
    var totalLen = fracLen + intLen + 1;  // +1 for '.'
    if (neg) { totalLen += 1; }
    var result = new([totalLen]byte);
    var pos = 0;
    if (neg) {
        result[0] = 45;  // '-'
        pos = 1;
    }
    // Integer digits (reverse)
    for (var j = 0; j < intLen; j += 1) {
        result[pos + j] = intBuf[intLen - 1 - j];
    }
    pos += intLen;
    result[pos] = 46;  // '.'
    pos += 1;
    for (var j = 0; j < fracLen; j += 1) {
        result[pos + j] = fracBuf[j];
    }
    return result;
}

// Format a bool as "true" or "false".
export func formatBool(v bool) [*#]byte {
    if (v) {
        return "true";
    }
    return "false";
}

export
class Node`K, V` final {
    export
    const key K;
    export
    var value V;
    var next *Node`K, V`;
}


class HashMap`K, V` (Map`K, V`) {
    const hashing !func(&!Node`K, V`) int;
    var buckets [*]*Node`K, V`;
    var size int;
    var threshold int;

    func indexed#(n &!Node`K,V`) int {
        var b = buckets;
        if (b == nil) return 0;
        var h = hashing(n);
        return h & (b.length-1);
    }

    func rehash() [*]*Node`K, V` {
        var b = buckets;
        if (b == nil) {
            var newBuck = new([16]*Node`K, V`);
            buckets = newBuck;
            threshold = int(float32(newBuck.length) * 0.75);
            return newBuck;
        }

        if (size < threshold) {
            return b;
        }

        var cap = b.length << 1;
        var newBuck = new([cap]*Node`K, V`);
        for (var i=0; i<b.length; i += 1) {
            var cur = b[i];
            for (cur != nil) {
                var next = cur.next;
                var idx = hashing(cur) % cap;
                cur.next = newBuck[idx];
                newBuck[idx] = cur;
                cur = next;
            }
        }
        b = newBuck;
        buckets = b;
        threshold = int(float32(b.length) * 0.75);
        return b;
    }

    export
    func set(key K, value V) Result`V` {
        var bucks = rehash();
        if (bucks == nil) return {};
        var nn Node`K,V` = {key=key,value=value};
        var idx = indexed(nn);
        var cur = bucks[idx];
        if (cur == nil) {
            bucks[idx] = new(Node`K, V`, nn);
            size += 1;
            return {ok=true};
        }

        var prev *Node`K, V` = nil;
        for (cur != nil) {
            if (key == cur.key) {
                var old = cur.value;
                cur.value = value;
                return {v=old};
            }
            prev = cur;
            cur = cur.next;
        }
        if (prev == nil) return {};
        prev.next = new(Node`K, V`, nn);

        size += 1;

        return {ok=true};
    }

    export
    func get#(key K) Result`V` {
        var bk = buckets;
        if (bk == nil) {
            return {};
        }
        var kn Node`K,V` = {key=key};
        var idx = indexed(kn);
        var cur = bk[idx];
        if (cur == nil) {
            return {};
        }

        for (cur != nil && cur.key != key) {
            cur = cur.next;
        }
        if (cur == nil) return {};
        return {ok=true, v=cur.value};
    }
}

export
func newHashmap`K,V`(hashing !func(&!Node`K,V`)int) *!Map`K,V` {
    return new(HashMap`K,V`, {hashing=hashing});
}


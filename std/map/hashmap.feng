export
class Node`K, V` final {
    export
    const key K;
    export
    var value V;
    var next *?Node`K, V`;
}

export
class Hashing`K, V` final {
    export
    const hash func(&#Node`K, V`) int;
    export
    const equal func(&#Node`K, V`, &#Node`K, V`) bool;
}

class HashMap`K, V` (Map`K, V`) {
    const hashing Hashing`K, V`;
    var buckets [*?]*?Node`K, V`;
    var size int;
    var threshold int;

    func rehash() [*]*?Node`K, V` {
        var buckets = this.buckets;
        if (buckets == nil) {
            buckets = new([16]*?Node`K, V`);
        } else if (size < threshold) {
            return buckets;
        } else {
            var cap = buckets.length << 1;
            var newBuck = new([cap]*?Node`K, V`);
            for (var i=0; i<buckets.length; i += 1) {
                var cur = buckets[i];
                for (cur != nil) {
                    var next = cur.next;
                    var idx = hashing.hash(cur) & (cap-1);
                    cur.next = newBuck[idx];
                    newBuck[idx] = cur;
                    cur = next;
                }
            }
            buckets = newBuck;
        }
        if (buckets==nil) throw new(NilException);
        this.buckets=buckets;
        threshold = int(float32(buckets.length) * 0.75);
        return buckets;
    }

    export
    func set(key K, value V) Result`V` {
        var bucks = rehash();
        var nn Node`K,V` = {key=key,value=value};
        var idx = hashing.hash(nn)&(bucks.length-1);
        var cur = bucks[idx];
        if (cur == nil) {
            bucks[idx] = new(Node`K, V`, nn);
            size += 1;
            return {ok=true};
        }

        var prev *?Node`K, V` = nil;
        for (cur != nil) {
            if (hashing.equal(nn, cur)) {
                var old = cur.value;
                cur.value = value;
                return {v=old};
            }
            prev = cur;
            cur = cur.next;
        }
        if (prev==nil) throw new(NilException);
        prev.next = new(Node`K, V`, nn);

        size += 1;

        return {ok=true};
    }

    export
    func get#(key K) Result`V` {
        var bk = buckets;
        if (bk == nil) {
            return {};
        }
        var kn Node`K,V` = {key=key};
        var idx = hashing.hash(kn)&(bk.length-1);
        var cur = bk[idx];
        if (cur == nil) {
            return {};
        }

        for (cur != nil && hashing.equal(cur, kn)) {
            cur = cur.next;
        }
        if (cur == nil) return {};
        return {ok=true, v=cur.value};
    }

    export
    func remove(key K) Result`V` {
        var bk = buckets;
        if (bk == nil) {
            return {};
        }
        var kn Node`K,V` = {key=key};
        var idx = hashing.hash(kn)&(bk.length-1);
        var cur = bk[idx];
        var prev *?Node`K,V` = nil;
        for (cur != nil) {
            if (hashing.equal(cur, kn)) {
                if (prev == nil) {
                    bk[idx] = cur.next;
                } else {
                    prev.next = cur.next;
                }
                size -= 1;
                return {ok=true, v=cur.value};
            }
            prev = cur;
            cur = cur.next;
        }
        return {};
    }

    export func nodeCount() int {
        return size;
    }

    export func clear() {
        buckets = nil;
        size = 0;
        threshold = 0;
    }
}

export
func newHashmap`K,V`(hashing Hashing`K,V`) *Map`K,V` {
    return new(HashMap`K,V`, {hashing=hashing});
}

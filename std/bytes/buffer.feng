import std$util;

func newCapacity(cur, need int) int {
    var t = cur + need;
    var g = cur<2^12 ? cur*2 : cur+2^12;
    return t>=g ? t : g;
}


export
class BufferWriter (Writer) {
    var buf [*]byte;
    var len int;

    func growIfNeed(need int) {
        if (buf==nil) {
            var cap = newCapacity(0, need);
            buf = new([cap]byte);
            return;
        }
        if (len+need < buf.length)
            return;

        var newCap = newCapacity(buf.length, need);
        var nb = new([newCap]byte);
        for (var i=0; i<len; i += 1)
            nb[i] = buf[i];
        buf = nb;
    }

    export
    func write(data [&#]byte, offset int, length int) int {
        growIfNeed(length);
        for (var i = 0; i < length; i += 1) {
            buf[len] = data[offset + i];
            len += 1;
        }
        return length;
    }

    export
    func writeByte(b byte) {
        growIfNeed(1);
        buf[len] = b;
        len += 1;
    }

    export
    func get() ([*#]byte, int) {
        return (buf, len);
    }

    export
    func length() int {
        return len;
    }

    export
    func isEmpty() bool {
        return len == 0;
    }

    // Reset length to zero (does not free the buffer).
    export
    func clear() {
        len = 0;
    }

    export
    func copy() [*#]byte {
        var src = buf;
        var dst = new([len]byte);
        util$copy`byte`(src, dst, len);
        return dst;
    }

    export
    func reader() BufferReader {
        return {buf=buf,len=len};
    }
}

export
func newWriter() BufferWriter {
    return {};
}

export
class BufferReader {
    const buf [*#]byte;
    const len int;
    var off int;

    export
    func read(b [&]byte) int {
        var old = off;
        for (var i=0; off<len && i<b.length; off,i=off+1,i+1) {
            b[i] = buf[off];
        }
        return off-old;
    }

    // Reset to read from new data.
    export
    func reset(data [*#]byte, length int) {
        off = 0;
        // buf and len are const, so reset is done externally by creating new BufferReader
    }

    // Seek to an absolute position.
    export
    func seek(pos int) {
        if (pos < 0) { off = 0; }
        else if (pos > len) { off = len; }
        else { off = pos; }
    }

    // Number of bytes remaining to read.
    export
    func remaining() int {
        if (off >= len) { return 0; }
        return len - off;
    }

    // Whether all bytes have been read.
    export
    func isEmpty() bool {
        return off >= len;
    }
}

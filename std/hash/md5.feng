// ===== MD5 hash (RFC 1321) =====
// 128-bit output. For checksum use only.

import std$encoding;

const md5InitA uint32 = 0x67452301;
const md5InitB uint32 = 0xefcdab89;
const md5InitC uint32 = 0x98badcfe;
const md5InitD uint32 = 0x10325476;

const md5K [64]uint32 = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
    0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
    0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
    0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
    0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
    0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
    0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
    0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
    0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
];

const md5Shift [64]int = [
    7,12,17,22, 7,12,17,22, 7,12,17,22, 7,12,17,22,
    5, 9,14,20, 5, 9,14,20, 5, 9,14,20, 5, 9,14,20,
    4,11,16,23, 4,11,16,23, 4,11,16,23, 4,11,16,23,
    6,10,15,21, 6,10,15,21, 6,10,15,21, 6,10,15,21,
];

class Md5 (Hash) {
    var a, b, c, d uint32;
    var buf [64]byte;
    var len uint64;
    var nx int;

    func block(p [&#]byte) {
        var X [16]uint32;
        for (var i = 0; i < 16; i += 1) {
            var w [4]byte;
            var off = i * 4;
            w[0] = p[off]; w[1] = p[off+1]; w[2] = p[off+2]; w[3] = p[off+3];
            X[i] = encoding$littleUint32(w);
        }
        var aa = a; var bb = b; var cc = c; var dd = d;
        for (var i = 0; i < 64; i += 1) {
            var g int;
            if (i < 16) { g = i; }
            else if (i < 32) { g = (5 * i + 1) % 16; }
            else if (i < 48) { g = (3 * i + 5) % 16; }
            else { g = (7 * i) % 16; }

            var mod = i % 4;
            if (mod == 0) {
                var fv uint32;
                if (i < 16) { fv = (bb & cc) | ((!bb) & dd); }
                else if (i < 32) { fv = (bb & dd) | (cc & (!dd)); }
                else if (i < 48) { fv = bb ~ cc ~ dd; }
                else { fv = cc ~ (bb | (!dd)); }
                var t = aa + fv + X[g] + md5K[i];
                aa = bb + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            } else if (mod == 1) {
                var fv uint32;
                if (i < 16) { fv = (aa & bb) | ((!aa) & cc); }
                else if (i < 32) { fv = (aa & cc) | (bb & (!cc)); }
                else if (i < 48) { fv = aa ~ bb ~ cc; }
                else { fv = bb ~ (aa | (!cc)); }
                var t = dd + fv + X[g] + md5K[i];
                dd = aa + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            } else if (mod == 2) {
                var fv uint32;
                if (i < 16) { fv = (dd & aa) | ((!dd) & bb); }
                else if (i < 32) { fv = (dd & bb) | (aa & (!bb)); }
                else if (i < 48) { fv = dd ~ aa ~ bb; }
                else { fv = aa ~ (dd | (!bb)); }
                var t = cc + fv + X[g] + md5K[i];
                cc = dd + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            } else {
                var fv uint32;
                if (i < 16) { fv = (cc & dd) | ((!cc) & aa); }
                else if (i < 32) { fv = (cc & aa) | (dd & (!aa)); }
                else if (i < 48) { fv = cc ~ dd ~ aa; }
                else { fv = dd ~ (cc | (!aa)); }
                var t = bb + fv + X[g] + md5K[i];
                bb = cc + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            }
        }
        a = a + aa; b = b + bb; c = c + cc; d = d + dd;
    }

    export func write(data [&#]byte) int {
        for (var i = 0; i < data.length; i += 1) {
            buf[nx] = data[i]; nx += 1; len += 1;
            if (nx == 64) { block(buf); nx = 0; }
        }
        return data.length;
    }

    export func sum(out [&]byte) int {
        var a2 = a; var b2 = b; var c2 = c; var d2 = d;
        var n2 = nx; var l2 = len;
        var tbuf [64]byte;
        for (var i = 0; i < n2; i += 1) { tbuf[i] = buf[i]; }
        tbuf[n2] = 128;
        for (var i = n2 + 1; i < 56; i += 1) { tbuf[i] = 0; }
        var w8 [8]byte;
        encoding$putLittleUint64(w8, l2 * 8);
        for (var i = 0; i < 8; i += 1) { tbuf[56+i] = w8[i]; }

        var X [16]uint32;
        for (var i = 0; i < 16; i += 1) {
            var w [4]byte;
            var off = i * 4;
            w[0] = tbuf[off]; w[1] = tbuf[off+1]; w[2] = tbuf[off+2]; w[3] = tbuf[off+3];
            X[i] = encoding$littleUint32(w);
        }

        for (var i = 0; i < 64; i += 1) {
            var g int;
            if (i < 16) { g = i; }
            else if (i < 32) { g = (5 * i + 1) % 16; }
            else if (i < 48) { g = (3 * i + 5) % 16; }
            else { g = (7 * i) % 16; }
            var fv uint32;
            if (i < 16) {
                if (i % 4 == 0) { fv = (b2 & c2) | ((!b2) & d2); }
                else if (i % 4 == 1) { fv = (a2 & b2) | ((!a2) & c2); }
                else if (i % 4 == 2) { fv = (d2 & a2) | ((!d2) & b2); }
                else { fv = (c2 & d2) | ((!c2) & a2); }
            } else if (i < 32) {
                if (i % 4 == 0) { fv = (b2 & d2) | (c2 & (!d2)); }
                else if (i % 4 == 1) { fv = (a2 & c2) | (b2 & (!c2)); }
                else if (i % 4 == 2) { fv = (d2 & b2) | (a2 & (!b2)); }
                else { fv = (c2 & a2) | (d2 & (!a2)); }
            } else if (i < 48) {
                if (i % 4 == 0) { fv = b2 ~ c2 ~ d2; }
                else if (i % 4 == 1) { fv = a2 ~ b2 ~ c2; }
                else if (i % 4 == 2) { fv = d2 ~ a2 ~ b2; }
                else { fv = c2 ~ d2 ~ a2; }
            } else {
                if (i % 4 == 0) { fv = c2 ~ (b2 | (!d2)); }
                else if (i % 4 == 1) { fv = b2 ~ (a2 | (!c2)); }
                else if (i % 4 == 2) { fv = a2 ~ (d2 | (!b2)); }
                else { fv = d2 ~ (c2 | (!a2)); }
            }
            if (i % 4 == 0) {
                var t = a2 + fv + X[g] + md5K[i];
                a2 = b2 + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            } else if (i % 4 == 1) {
                var t = d2 + fv + X[g] + md5K[i];
                d2 = a2 + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            } else if (i % 4 == 2) {
                var t = c2 + fv + X[g] + md5K[i];
                c2 = d2 + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            } else {
                var t = b2 + fv + X[g] + md5K[i];
                b2 = c2 + ((t << md5Shift[i]) | (t >> (32 - md5Shift[i])));
            }
        }

        a2 = md5InitA + a2; b2 = md5InitB + b2;
        c2 = md5InitC + c2; d2 = md5InitD + d2;

        var ow [4]byte;
        encoding$putLittleUint32(ow, a2);
        out[0]=ow[0]; out[1]=ow[1]; out[2]=ow[2]; out[3]=ow[3];
        encoding$putLittleUint32(ow, b2);
        out[4]=ow[0]; out[5]=ow[1]; out[6]=ow[2]; out[7]=ow[3];
        encoding$putLittleUint32(ow, c2);
        out[8]=ow[0]; out[9]=ow[1]; out[10]=ow[2]; out[11]=ow[3];
        encoding$putLittleUint32(ow, d2);
        out[12]=ow[0]; out[13]=ow[1]; out[14]=ow[2]; out[15]=ow[3];
        return 16;
    }

    export func reset() { a=md5InitA; b=md5InitB; c=md5InitC; d=md5InitD; len=0; nx=0; }
    export func size() int { return 16; }
}

export func newMd5() *Hash {
    return new(Md5, {a=md5InitA, b=md5InitB, c=md5InitC, d=md5InitD});
}

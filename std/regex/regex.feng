// Regular expression engine: bytecode VM with an explicit backtracking stack.
//
// Supported syntax (subset of PCRE/Go regexp):
//   .  ^  $  |  ( )  (?: )
//   *  +  ?  {n}  {n,}  {n,m}
//   [abc]  [^abc]  [a-z]  \d \w \s \D \W \S \b \B
//   \n \t \r \f \v \0 \\ \xNN \uNNNN  and escaped metacharacters
//
// The pattern is compiled to a bytecode program. Split/Jmp offsets are
// relative to the instruction position, so a copied body stays relocatable.
// Matching uses a backtracking stack of frames (pc, pos, caps snapshot).

import std$string;

// ---- bytecode opcodes ----
const OP_CHAR = 1;
const OP_CLASS = 2;
const OP_ANY = 3;
const OP_SPLIT = 4;
const OP_JMP = 5;
const OP_SAVE = 6;
const OP_BOL = 7;
const OP_EOL = 8;
const OP_WB = 9;
const OP_NWB = 10;
const OP_MATCH = 11;

// Safety limits.
const MAX_REPEAT = 100000;
const MAX_EXTRA = 10000;
const MAX_PROG = 1000000;
const MAX_GROUPS = 100;
const MAX_STK = 1048576;

export
class PatternSyntaxException : Exception {
    var message string$String;
}

func syntaxError(message string$String) *PatternSyntaxException {
    return new(PatternSyntaxException, {message=message});
}

// A single bytecode instruction.
class Inst {
    var op int;
    var c int;
    var neg int;
    var x int;
    var y int;
    var cls [*?]byte;
}

// ---------------------------------------------------------------------------
// Parser: compiles a pattern into the bytecode program.
// ---------------------------------------------------------------------------

class Parser {
    var pat [*]byte;
    var pos int;
    var psize int;
    var ngroup int;
    var prog [*]Inst;
    var jmps [*]int;
    var jmpsSize int;

    func peek() int {
        if (pos >= pat.length) { return -1; }
        return int(pat[pos]);
    }

    func ensureProg(need int) {
        if (prog.length >= need) { return; }
        var cap = prog.length;
        var grow = cap < 1024 ? cap * 2 : cap + 1024;
        if (need > grow) { grow = need; }
        var nb = new([grow]Inst);
        for (var i = 0; i < psize; i += 1) {
            nb[i] = prog[i];
        }
        prog = nb;
    }

    func addIns(op int, c int, neg int, x int, y int, cls [*?]byte) int {
        ensureProg(psize + 1);
        prog[psize] = {op=op, c=c, neg=neg, x=x, y=y, cls=cls};
        psize += 1;
        return psize - 1;
    }

    func insertSplitAt(pos int, x int, y int) {
        ensureProg(psize + 1);
        for (var i = psize; i > pos; i -= 1) {
            prog[i] = prog[i - 1];
        }
        prog[pos] = {op=OP_SPLIT, c=0, neg=0, x=x, y=y, cls=nil};
        psize += 1;
    }

    func insertJmpAt(pos int, off int) {
        ensureProg(psize + 1);
        for (var i = psize; i > pos; i -= 1) {
            prog[i] = prog[i - 1];
        }
        prog[pos] = {op=OP_JMP, c=0, neg=0, x=off, y=0, cls=nil};
        psize += 1;
    }

    func copyBody(s int, e int) int {
        var n = e - s;
        ensureProg(psize + n);
        var d = psize;
        for (var i = 0; i < n; i += 1) {
            prog[d + i] = prog[s + i];
        }
        psize += n;
        return d;
    }

    func pushJmp(p int) {
        if (jmpsSize == jmps.length) {
            var cap = jmps.length;
            var grow = cap < 16 ? 16 : cap * 2;
            var nb = new([grow]int);
            for (var i = 0; i < jmpsSize; i += 1) {
                nb[i] = jmps[i];
            }
            jmps = nb;
        }
        jmps[jmpsSize] = p;
        jmpsSize += 1;
    }

    func patchJmps(from int, exit int) {
        for (var i = from; i < jmpsSize; i += 1) {
            var p = jmps[i];
            prog[p].x = exit - p;
        }
        jmpsSize = from;
    }

    // Wrap body [s, e) as body* : SPLIT before the body, JMP back at the end.
    // After the split insertion the body occupies [s+1, e+1) and the JMP sits
    // at e+1. The split's skip offset must land past the JMP (e+2), and the
    // JMP must loop back to the SPLIT (index s) so every iteration re-evaluates
    // the exit choice and pushes a fresh frame.
    func wrapStar(s int, e int) {
        insertSplitAt(s, 1, e + 2 - s);
        addIns(OP_JMP, 0, 0, s - e - 1, 0, nil);
    }

    // Wrap body [s, e) as body? : SPLIT before the body only.
    func wrapQuest(s int, e int) {
        insertSplitAt(s, 1, e + 1 - s);
    }

    // body+ = body (body)* : keep the original, wrap a copy as a star.
    func wrapPlus(s int, e int) {
        var n = e - s;
        var c = copyBody(s, e);
        wrapStar(c, c + n);
    }

    // Append (body)? at the current end.
    func appendOptional(s int, e int) {
        var sp = addIns(OP_SPLIT, 0, 0, 1, 0, nil);
        copyBody(s, e);
        prog[sp].y = psize - sp;
    }

    // Can [s, e) match the empty string?
    func isNullable(s int, e int) bool {
        var stk = new([2 * (e - s + 1)]int);
        var seen = new([e]bool);
        var top = 0;
        stk[top] = s;
        top += 1;
        for (top > 0) {
            top -= 1;
            var i = stk[top];
            if (i >= e) { return true; }
            if (i < s || seen[i]) { continue; }
            seen[i] = true;
            var op = prog[i].op;
            if (op == OP_CHAR || op == OP_CLASS || op == OP_ANY) { continue; }
            if (op == OP_SPLIT) {
                stk[top] = i + 1; top += 1;
                stk[top] = i + prog[i].y; top += 1;
                continue;
            }
            if (op == OP_JMP) {
                stk[top] = i + prog[i].x; top += 1;
                continue;
            }
            stk[top] = i + 1; top += 1;
        }
        return false;
    }

    // Try to parse {n}, {n,} or {n,m} at pos (pointing at '{').
    // Returns (ok, n, m); m == -1 means unbounded. Restores pos on failure.
    func tryBrace() (bool, int, int) {
        var save = pos;
        pos += 1;
        if (pos >= pat.length) { pos = save; return (false, 0, 0); }
        var n = 0;
        var dig = false;
        for (pos < pat.length && int(pat[pos]) >= 48 && int(pat[pos]) <= 57) {
            n = n * 10 + (int(pat[pos]) - 48);
            dig = true;
            pos += 1;
        }
        if (!dig) { pos = save; return (false, 0, 0); }
        if (pos >= pat.length) { pos = save; return (false, 0, 0); }
        if (int(pat[pos]) == 125) {   // '}'
            pos += 1;
            return (true, n, n);
        }
        if (int(pat[pos]) != 44) { pos = save; return (false, 0, 0); }  // ','
        pos += 1;
        var m = 0;
        var mdig = false;
        for (pos < pat.length && int(pat[pos]) >= 48 && int(pat[pos]) <= 57) {
            m = m * 10 + (int(pat[pos]) - 48);
            mdig = true;
            pos += 1;
        }
        if (pos >= pat.length || int(pat[pos]) != 125) {
            pos = save;
            return (false, 0, 0);
        }
        pos += 1;
        if (!mdig) { return (true, n, -1); }
        return (true, n, m);
    }

    func readHex(n int) int {
        var v = 0;
        for (var i = 0; i < n; i += 1) {
            if (pos >= pat.length) { return -1; }
            var ch = int(pat[pos]);
            var d = -1;
            if (ch >= 48 && ch <= 57) { d = ch - 48; }
            if (ch >= 97 && ch <= 102) { d = ch - 87; }
            if (ch >= 65 && ch <= 70) { d = ch - 55; }
            if (d < 0) { return -1; }
            v = v * 16 + d;
            pos += 1;
        }
        return v;
    }

    // Simple escape without a value (returns the character or -1).
    func escChar(ch int) int {
        if (ch == 110) { return 10; }  // \n
        if (ch == 116) { return 9; }   // \t
        if (ch == 114) { return 13; }  // \r
        if (ch == 102) { return 12; }  // \f
        if (ch == 118) { return 11; }  // \v
        if (ch == 48) { return 0; }    // \0
        if (ch == 92) { return 92; }   // \\
        if (ch == 46) { return 46; }
        if (ch == 42) { return 42; }
        if (ch == 43) { return 43; }
        if (ch == 63) { return 63; }
        if (ch == 40) { return 40; }
        if (ch == 41) { return 41; }
        if (ch == 91) { return 91; }
        if (ch == 93) { return 93; }
        if (ch == 123) { return 123; }
        if (ch == 125) { return 125; }
        if (ch == 94) { return 94; }
        if (ch == 36) { return 36; }
        if (ch == 124) { return 124; }
        if (ch == 45) { return 45; }
        if (ch == 47) { return 47; }
        if (ch == 32) { return 32; }
        return -1;
    }

    // Parse an escape at pos (pointing at the escaped character, the '\'
    // has already been consumed by the caller). Returns (kind, value, neg):
    //   kind 1: literal character (value)
    //   kind 2: preset class (value: 1=digit, 2=word, 3=space; neg)
    //   kind 3: boundary assertion (value: 0=word boundary, 1=non-boundary)
    func parseEscape() (int, int, int) {
        if (pos >= pat.length) {
            throw syntaxError(string$utf8("trailing backslash"));
        }
        var ch = int(pat[pos]);
        pos += 1;
        if (ch == 100) { return (2, 1, 0); }  // \d
        if (ch == 68) { return (2, 1, 1); }   // \D
        if (ch == 119) { return (2, 2, 0); }  // \w
        if (ch == 87) { return (2, 2, 1); }   // \W
        if (ch == 115) { return (2, 3, 0); }  // \s
        if (ch == 83) { return (2, 3, 1); }   // \S
        if (ch == 98) { return (3, 0, 0); }   // \b
        if (ch == 66) { return (3, 1, 0); }   // \B
        if (ch == 120) {                      // \xNN
            var v = readHex(2);
            if (v < 0) { throw syntaxError(string$utf8("invalid hex escape")); }
            return (1, v, 0);
        }
        if (ch == 117) {                      // \uNNNN
            var v = readHex(4);
            if (v < 0) { throw syntaxError(string$utf8("invalid unicode escape")); }
            if (v > 255) { throw syntaxError(string$utf8("unicode escape out of range")); }
            return (1, v, 0);
        }
        var v = escChar(ch);
        if (v < 0) { throw syntaxError(string$utf8("unknown escape")); }
        return (1, v, 0);
    }

    func unionDigit(set [*]byte) {
        for (var i = 48; i <= 57; i += 1) { set[i] = byte(1); }
    }

    func unionWord(set [*]byte) {
        for (var i = 48; i <= 57; i += 1) { set[i] = byte(1); }
        for (var i = 65; i <= 90; i += 1) { set[i] = byte(1); }
        for (var i = 97; i <= 122; i += 1) { set[i] = byte(1); }
        set[95] = byte(1);
    }

    func unionSpace(set [*]byte) {
        set[32] = byte(1); set[9] = byte(1); set[10] = byte(1); set[13] = byte(1); set[11] = byte(1); set[12] = byte(1);
    }

    func presetClass(kind int) [*]byte {
        var set = new([256]byte);
        if (kind == 1) {
            unionDigit(set);
        } else if (kind == 2) {
            unionWord(set);
        } else {
            unionSpace(set);
        }
        return set;
    }

    // Parse a character class. Caller (parseAtom) has consumed '[' already;
    // pos points at the first character of the class. Returns (negated, set).
    func parseClass() (bool, [*]byte) {
        var set = new([256]byte);
        var neg = false;
        var first = true;
        for (true) {
            if (pos >= pat.length) {
                throw syntaxError(string$utf8("unterminated character class"));
            }
            var ch = int(pat[pos]);
            if (first && ch == 94) {  // '^'
                neg = true;
                first = false;
                pos += 1;
                continue;
            }
            if (ch == 93 && !first) {  // ']'
                pos += 1;
                break;
            }
            first = false;
            pos += 1;
            if (ch == 92) {  // '\'
                if (pos >= pat.length) {
                    throw syntaxError(string$utf8("unterminated escape in class"));
                }
                var ec = int(pat[pos]);
                pos += 1;
                if (ec == 100) { unionDigit(set); continue; }
                if (ec == 119) { unionWord(set); continue; }
                if (ec == 115) { unionSpace(set); continue; }
                if (ec == 68 || ec == 87 || ec == 83) {
                    throw syntaxError(string$utf8("negated escapes not allowed inside class; use [^...]"));
                }
                if (ec == 98) { set[8] = byte(1); continue; }  // \b in class = backspace
                if (ec == 120) {
                    var v = readHex(2);
                    if (v < 0) { throw syntaxError(string$utf8("invalid hex escape")); }
                    set[v] = byte(1);
                    continue;
                }
                if (ec == 117) {
                    var v = readHex(4);
                    if (v < 0) { throw syntaxError(string$utf8("invalid unicode escape")); }
                    if (v > 255) { throw syntaxError(string$utf8("unicode escape out of range")); }
                    set[v] = byte(1);
                    continue;
                }
                var v = escChar(ec);
                if (v < 0) { throw syntaxError(string$utf8("unknown escape in class")); }
                set[v] = byte(1);
                continue;
            }
            // Range: ch - hi (hi is not ']')
            if (pos < pat.length && int(pat[pos]) == 45 && pos + 1 < pat.length && int(pat[pos + 1]) != 93) {
                var lo = ch;
                pos += 1;
                var hi = int(pat[pos]);
                pos += 1;
                if (hi == 92) {  // escaped upper bound
                    if (pos >= pat.length) {
                        throw syntaxError(string$utf8("unterminated range"));
                    }
                    var ev = escChar(int(pat[pos]));
                    if (ev < 0) { throw syntaxError(string$utf8("unknown escape in range")); }
                    pos += 1;
                    hi = ev;
                }
                if (hi < lo) { throw syntaxError(string$utf8("invalid character range")); }
                for (var i = lo; i <= hi; i += 1) {
                    set[i] = byte(1);
                }
                continue;
            }
            set[ch] = byte(1);
        }
        return (neg, set);
    }

    // Parse one atom. Returns (ok, bodyStart).
    func parseAtom() (bool, int) {
        if (pos >= pat.length) { return (false, 0); }
        var ch = int(pat[pos]);
        pos += 1;
        if (ch == 40) {  // '('
            var cap = -1;
            if (pos < pat.length && int(pat[pos]) == 63) {  // '?'
                if (pos + 1 < pat.length && int(pat[pos + 1]) == 58) {  // ':'
                    pos += 2;
                } else {
                    throw syntaxError(string$utf8("unsupported group syntax; only (?: supported"));
                }
            } else {
                ngroup += 1;
                if (ngroup > MAX_GROUPS) {
                    throw syntaxError(string$utf8("too many groups"));
                }
                cap = ngroup;
                addIns(OP_SAVE, 2 * cap, 0, 0, 0, nil);
            }
            var s = psize;
            parseAlt();
            if (pos >= pat.length || int(pat[pos]) != 41) {  // ')'
                throw syntaxError(string$utf8("unmatched parenthesis"));
            }
            pos += 1;
            if (cap >= 0) {
                addIns(OP_SAVE, 2 * cap + 1, 0, 0, 0, nil);
            }
            return (true, s);
        }
        if (ch == 91) {  // '['
            var r = parseClass();
            addIns(OP_CLASS, 0, r.0 ? 1 : 0, 0, 0, r.1);
            return (true, psize - 1);
        }
        if (ch == 46) {  // '.'
            addIns(OP_ANY, 0, 0, 0, 0, nil);
            return (true, psize - 1);
        }
        if (ch == 94) {  // '^'
            addIns(OP_BOL, 0, 0, 0, 0, nil);
            return (true, psize - 1);
        }
        if (ch == 36) {  // '$'
            addIns(OP_EOL, 0, 0, 0, 0, nil);
            return (true, psize - 1);
        }
        if (ch == 92) {  // '\'
            var r = parseEscape();
            var kind = r.0;
            if (kind == 1) {
                addIns(OP_CHAR, r.1, 0, 0, 0, nil);
            } else if (kind == 2) {
                addIns(OP_CLASS, 0, r.2, 0, 0, presetClass(r.1));
            } else {
                if (r.1 == 0) {
                    addIns(OP_WB, 0, 0, 0, 0, nil);
                } else {
                    addIns(OP_NWB, 0, 0, 0, 0, nil);
                }
            }
            return (true, psize - 1);
        }
        if (ch == 41 || ch == 124 || ch == 42 || ch == 43 || ch == 63) {
            // ')' '|' '*' '+' '?' are not valid atom starts here.
            pos -= 1;
            return (false, 0);
        }
        if (ch == 123) {  // '{'
            var r = tryBrace();
            if (r.0) {
                throw syntaxError(string$utf8("nothing to repeat"));
            }
            addIns(OP_CHAR, 123, 0, 0, 0, nil);
            return (true, psize - 1);
        }
        // Ordinary literal (including '}' '-' ']' and friends).
        addIns(OP_CHAR, int(ch), 0, 0, 0, nil);
        return (true, psize - 1);
    }

    // Apply a quantifier suffix to body [s, e). pos points at the quantifier.
    func parseRepeat(s int, e int) {
        if (pos >= pat.length) { return; }
        var ch = int(pat[pos]);
        if (ch == 42) {  // '*'
            pos += 1;
            if (isNullable(s, e)) {
                throw syntaxError(string$utf8("quantifier on nullable expression"));
            }
            wrapStar(s, e);
            return;
        }
        if (ch == 43) {  // '+'
            pos += 1;
            if (isNullable(s, e)) {
                throw syntaxError(string$utf8("quantifier on nullable expression"));
            }
            wrapPlus(s, e);
            return;
        }
        if (ch == 63) {  // '?'
            pos += 1;
            wrapQuest(s, e);
            return;
        }
        if (ch == 123) {  // '{'
            var r = tryBrace();
            if (!r.0) { return; }
            var n = r.1;
            var m = r.2;
            if (n > MAX_REPEAT) {
                throw syntaxError(string$utf8("repetition too large"));
            }
            if (m >= 0 && n > m) {
                throw syntaxError(string$utf8("invalid repetition range"));
            }
            if (m >= 0 && m - n > MAX_EXTRA) {
                throw syntaxError(string$utf8("repetition range too large"));
            }
            if (n > 0 && isNullable(s, e)) {
                throw syntaxError(string$utf8("quantifier on nullable expression"));
            }
            if (m == n) {
                // Exactly n times.
                if (n == 0) {
                    insertJmpAt(s, e + 1 - s);
                    return;
                }
                for (var i = 1; i < n; i += 1) {
                    copyBody(s, e);
                }
                return;
            }
            if (m < 0) {
                // At least n times: n mandatory copies + one starred copy.
                for (var i = 1; i < n; i += 1) {
                    copyBody(s, e);
                }
                if (n == 0) {
                    wrapStar(s, e);
                } else {
                    // The starred copy is added AFTER the n mandatory ones;
                    // wrapStar inserts its split at that copy's position.
                    var len0 = e - s;
                    var c = copyBody(s, e);
                    wrapStar(c, c + len0);
                }
                return;
            }
            // Between n and m times.
            for (var i = 1; i < n; i += 1) {
                copyBody(s, e);
            }
            if (n == 0) {
                // No mandatory copy: the original body itself must be optional.
                // wrapQuest inserts a split at s, shifting the body to [s+1, e+1).
                wrapQuest(s, e);
                for (var i = 0; i < m - n - 1; i += 1) {
                    appendOptional(s + 1, e + 1);
                }
            } else {
                for (var i = 0; i < m - n; i += 1) {
                    appendOptional(s, e);
                }
            }
        }
    }

    func parseConcat() {
        for (true) {
            var r = parseAtom();
            if (!r.0) { break; }
            parseRepeat(r.1, psize);
        }
    }

    // Alternation with leftmost-first (backtracking) semantics:
    //   SPLIT(b1, g2); b1; JMP(exit); g2: SPLIT(b2, g3); b2; JMP(exit); g3: SPLIT(b3, exit); b3; exit:
    func parseAlt() int {
        var saved = jmpsSize;
        var s = psize;
        parseConcat();
        if (peek() != 124) {  // '|'
            return psize - s;
        }
        insertSplitAt(s, 1, 0);
        var pending = s;
        pos += 1;
        for (true) {
            var jp = addIns(OP_JMP, 0, 0, 0, 0, nil);
            pushJmp(jp);
            var sp = addIns(OP_SPLIT, 0, 0, 1, 0, nil);
            prog[pending].y = sp - pending;
            pending = sp;
            parseConcat();
            if (peek() != 124) { break; }
            pos += 1;
        }
        prog[pending].y = psize - pending;
        patchJmps(saved, psize);
        return psize - s;
    }
}

func newParser(pattern [&#]byte) Parser {
    var n = pattern.length;
    var buf = new([n]byte);
    for (var i = 0; i < n; i += 1) {
        buf[i] = pattern[i];
    }
    return {pat=buf, pos=0, psize=0, ngroup=0, prog=new([16]Inst), jmps=new([16]int), jmpsSize=0};
}

// Compile a pattern. Throws PatternSyntaxException on invalid syntax.
export
func compile(pattern [&#]byte) *Regex {
    var p = newParser(pattern);
    p.addIns(OP_SAVE, 0, 0, 0, 0, nil);
    p.parseAlt();
    if (p.pos < p.pat.length) {
        throw syntaxError(string$utf8("unexpected character in pattern"));
    }
    p.addIns(OP_SAVE, 1, 0, 0, 0, nil);
    p.addIns(OP_MATCH, 0, 0, 0, 0, nil);
    if (p.psize > MAX_PROG) {
        throw syntaxError(string$utf8("program too large"));
    }
    var prog = new([p.psize]Inst);
    for (var i = 0; i < p.psize; i += 1) {
        prog[i] = p.prog[i];
    }
    return new(Regex, {prog=prog, ncap=2 * (p.ngroup + 1), ngroup=p.ngroup});
}

// ---------------------------------------------------------------------------
// Matcher: runs the bytecode program with an explicit backtracking stack.
// ---------------------------------------------------------------------------

class Matcher {
    var prog [*]Inst;
    var input [*]byte;
    var len int;
    var ncap int;
    var caps [*]int;
    var stk [*]int;
    var stkTop int;
    var full bool;

    func growStk(need int) {
        var cap = stk.length;
        var grow = cap < 1024 ? cap * 2 : cap + 1024;
        if (need > grow) { grow = need; }
        var nb = new([grow]int);
        for (var i = 0; i < stkTop; i += 1) {
            nb[i] = stk[i];
        }
        stk = nb;
    }

    // Frame: [pc, pos, caps snapshot] (size ncap+2).
    func pushFrame(pc int, pos int) bool {
        var need = stkTop + ncap + 2;
        if (need > MAX_STK) { return false; }
        if (need > stk.length) { growStk(need); }
        stk[stkTop] = pc;
        stkTop += 1;
        stk[stkTop] = pos;
        stkTop += 1;
        for (var i = 0; i < ncap; i += 1) {
            stk[stkTop] = caps[i];
            stkTop += 1;
        }
        return true;
    }

    // Pop the most recent backtrack frame. Returns (pc, pos), or (-1, -1).
    func backtrack() (int, int) {
        if (stkTop <= 0) { return (-1, -1); }
        stkTop -= ncap;
        for (var i = 0; i < ncap; i += 1) {
            caps[i] = stk[stkTop + i];
        }
        stkTop -= 2;
        var pc = stk[stkTop];
        var pos = stk[stkTop + 1];
        return (pc, pos);
    }

    // Run the program from `start`. Returns the match end (or -1).
    // On success caps[0] == start and caps[1] == end.
    func runAt(start int) int {
        if (start < 0 || start > len) { return -1; }
        for (var i = 0; i < ncap; i += 1) { caps[i] = -1; }
        caps[0] = start;
        // A successful match returns without popping its backtrack frames, so
        // each attempt must start with a fresh stack; otherwise stale frames
        // from a previous runAt corrupt the next attempt's backtracking.
        stkTop = 0;
        var pc = 0;
        var pos = start;
        for (true) {
            if (pc < 0 || pc >= prog.length) { return -1; }
            var ins = prog[pc];
            var op = ins.op;
            if (op == OP_CHAR) {
                if (pos < len && int(input[pos]) == ins.c) {
                    pos += 1;
                    pc += 1;
                } else {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                }
                continue;
            }
            if (op == OP_CLASS) {
                var cls = ins.cls;
                var hit = false;
                if (pos < len) {
                    hit = cls != nil && cls[int(input[pos])] != 0;
                    if (ins.neg != 0) { hit = !hit; }
                }
                if (hit) {
                    pos += 1;
                    pc += 1;
                } else {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                }
                continue;
            }
            if (op == OP_ANY) {
                if (pos < len) {
                    pos += 1;
                    pc += 1;
                } else {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                }
                continue;
            }
            if (op == OP_SPLIT) {
                if (!pushFrame(pc + ins.y, pos)) { return -1; }
                pc += ins.x;
                continue;
            }
            if (op == OP_JMP) {
                pc += ins.x;
                continue;
            }
            if (op == OP_SAVE) {
                caps[ins.c] = pos;
                pc += 1;
                continue;
            }
            if (op == OP_BOL) {
                if (pos == 0) {
                    pc += 1;
                } else {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                }
                continue;
            }
            if (op == OP_EOL) {
                if (pos == len || (pos == len - 1 && int(input[pos]) == 10)) {
                    pc += 1;
                } else {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                }
                continue;
            }
            if (op == OP_WB || op == OP_NWB) {
                var w1 = pos > 0 && isWordByte(int(input[pos - 1]));
                var w2 = pos < len && isWordByte(int(input[pos]));
                var b = w1 != w2;
                if ((op == OP_WB && b) || (op == OP_NWB && !b)) {
                    pc += 1;
                } else {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                }
                continue;
            }
            if (op == OP_MATCH) {
                caps[1] = pos;
                if (full && caps[1] != len) {
                    var r = backtrack();
                    if (r.0 < 0) { return -1; }
                    pc = r.0;
                    pos = r.1;
                    continue;
                }
                return pos;
            }
            return -1;
        }
    }

    // Find the first match at position >= start. Returns the start (or -1).
    func findFrom(start int) int {
        for (var i = start; i <= len; i += 1) {
            var e = runAt(i);
            if (e >= 0) { return i; }
        }
        return -1;
    }

    func sliceString(a int, b int) string$String {
        var n = b - a;
        var buf = new([n]byte);
        for (var i = 0; i < n; i += 1) {
            buf[i] = input[a + i];
        }
        return string$utf8(buf);
    }
}

func isWordByte(b int) bool {
    return (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

// ---------------------------------------------------------------------------
// Regex: the compiled pattern and its operations.
// ---------------------------------------------------------------------------

export
class Regex {
    var prog [*]Inst;
    var ncap int;
    var ngroup int;

    func newMatcher(s [&#]byte, full bool) Matcher {
        var n = s.length;
        var buf = new([n]byte);
        for (var i = 0; i < n; i += 1) {
            buf[i] = s[i];
        }
        return {prog=prog, input=buf, len=n, ncap=ncap, caps=new([ncap]int), stk=new([32]int), stkTop=0, full=full};
    }

    // The whole input must match.
    export
    func matches(s [&#]byte) bool {
        var m = newMatcher(s, true);
        return m.runAt(0) >= 0;
    }

    // Any substring may match.
    export
    func find(s [&#]byte) bool {
        var m = newMatcher(s, false);
        return m.findFrom(0) >= 0;
    }

    // (start, end) of the first match, or (-1, -1) if none.
    export
    func findIndex(s [&#]byte) (int, int) {
        var m = newMatcher(s, false);
        var st = m.findFrom(0);
        if (st < 0) { return (-1, -1); }
        return (st, m.caps[1]);
    }

    // Capture groups of the first match. Returns (ok, groups) where group i
    // (0-based over the pattern's capturing groups) is the substring or EMPTY.
    export
    func groups(s [&#]byte) (bool, [*]string$String) {
        var m = newMatcher(s, false);
        var st = m.findFrom(0);
        if (st < 0) { return (false, new([0]string$String)); }
        var g = new([ngroup]string$String);
        for (var i = 1; i <= ngroup; i += 1) {
            var a = m.caps[2 * i];
            var b = m.caps[2 * i + 1];
            if (a >= 0 && b >= 0) {
                g[i - 1] = m.sliceString(a, b);
            } else {
                g[i - 1] = string$EMPTY;
            }
        }
        return (true, g);
    }

    export
    func groupCount() int {
        return ngroup;
    }

    // Replace every non-empty match with rep. Empty matches insert rep but
    // consume no characters.
    export
    func replaceAll(s [&#]byte, rep [&#]byte) string$String {
        var m = newMatcher(s, false);
        var sb = string$newBuilder();
        var last = 0;
        var pos = 0;
        for (true) {
            var st = m.findFrom(pos);
            if (st < 0) { break; }
            var e = m.caps[1];
            for (var i = last; i < st; i += 1) {
                sb.appendByte(m.input[i]);
            }
            if (e == st) {
                if (st >= m.len) { break; }
                sb.appendBytes(rep);
                last = st;
                pos = st + 1;
            } else {
                sb.appendBytes(rep);
                last = e;
                pos = e;
            }
        }
        for (var i = last; i < m.len; i += 1) {
            sb.appendByte(m.input[i]);
        }
        return sb.build();
    }

    // Split by non-empty matches. Empty matches are skipped.
    export
    func split(s [&#]byte) [*]string$String {
        var m = newMatcher(s, false);
        var count = 1;
        var pos = 0;
        for (true) {
            var st = m.findFrom(pos);
            if (st < 0) { break; }
            var e = m.caps[1];
            if (e == st) {
                if (st >= m.len) { break; }
                pos = st + 1;
            } else {
                count += 1;
                pos = e;
            }
        }
        var parts = new([count]string$String);
        var idx = 0;
        var last = 0;
        pos = 0;
        for (true) {
            var st = m.findFrom(pos);
            if (st < 0) { break; }
            var e = m.caps[1];
            if (e == st) {
                if (st >= m.len) { break; }
                pos = st + 1;
            } else {
                parts[idx] = m.sliceString(last, st);
                idx += 1;
                last = e;
                pos = e;
            }
        }
        parts[idx] = m.sliceString(last, m.len);
        return parts;
    }
}

// ---------------------------------------------------------------------------
// Top-level convenience functions.
// ---------------------------------------------------------------------------

export
func matches(pattern [&#]byte, s [&#]byte) bool {
    var re = compile(pattern);
    return re.matches(s);
}

export
func find(pattern [&#]byte, s [&#]byte) bool {
    var re = compile(pattern);
    return re.find(s);
}

export
func findIndex(pattern [&#]byte, s [&#]byte) (int, int) {
    var re = compile(pattern);
    return re.findIndex(s);
}

export
func replaceAll(pattern [&#]byte, s [&#]byte, rep [&#]byte) string$String {
    var re = compile(pattern);
    return re.replaceAll(s, rep);
}

export
func split(pattern [&#]byte, s [&#]byte) [*]string$String {
    var re = compile(pattern);
    return re.split(s);
}

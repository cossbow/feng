import std$error;

// ===== Deque`T` — double-ended queue with ring buffer =====

export
class Deque`T` {
    var buf [*]T;
    var head int;
    var tail int;
    var size int;
}

// ===== factory functions =====

export func newDeque`T`() *Deque`T` {
    return new(Deque`T`);
}

export func newDequeCap`T`(cap int) *Deque`T` {
    var d = new(Deque`T`);
    if (cap > 0) {
        var initCap = 8;
        if (cap > initCap) {
            initCap = cap;
        }
        d.buf = new([initCap]T);
    }
    return d;
}

// ===== helper =====

func decIndex`T`(d *Deque`T`, i int) int {
    if (i == 0) {
        return d.buf.length - 1;
    }
    return i - 1;
}

func ensureCap`T`(d *Deque`T`) {
    if (d.buf == nil) {
        d.buf = new([8]T);
        d.head = 0;
        d.tail = 0;
        return;
    }
    if (d.size < d.buf.length) {
        return;
    }
    var newCap = d.buf.length * 2;
    var newBuf = new([newCap]T);
    for (var i = 0; i < d.size; i += 1) {
        newBuf[i] = d.buf[(d.head + i) % d.buf.length];
    }
    d.buf = newBuf;
    d.head = 0;
    d.tail = d.size;
}

// ===== add =====

export func dequePushFront`T`(d *Deque`T`, e T) {
    ensureCap`T`(d);
    d.head = decIndex`T`(d, d.head);
    d.buf[d.head] = e;
    d.size += 1;
}

export func dequePushBack`T`(d *Deque`T`, e T) {
    ensureCap`T`(d);
    d.buf[d.tail] = e;
    d.tail = (d.tail + 1) % d.buf.length;
    d.size += 1;
}

// ===== remove =====

export func dequePopFront`T`(d *Deque`T`) T {
    if (d.size == 0) {
        throw new(error$IllegalStateException);
    }
    var v = d.buf[d.head];
    d.head = (d.head + 1) % d.buf.length;
    d.size -= 1;
    return v;
}

export func dequePopBack`T`(d *Deque`T`) T {
    if (d.size == 0) {
        throw new(error$IllegalStateException);
    }
    d.tail = decIndex`T`(d, d.tail);
    var v = d.buf[d.tail];
    d.size -= 1;
    return v;
}

// ===== peek =====

export func dequePeekFront`T`(d *Deque`T`) T {
    if (d.size == 0) {
        throw new(error$IllegalStateException);
    }
    return d.buf[d.head];
}

export func dequePeekBack`T`(d *Deque`T`) T {
    if (d.size == 0) {
        throw new(error$IllegalStateException);
    }
    return d.buf[decIndex`T`(d, d.tail)];
}

// ===== properties =====

export func dequeLength`T`(d *Deque`T`) int {
    return d.size;
}

export func dequeIsEmpty`T`(d *Deque`T`) bool {
    return d.size == 0;
}

export func dequeClear`T`(d *Deque`T`) {
    d.head = 0;
    d.tail = 0;
    d.size = 0;
}

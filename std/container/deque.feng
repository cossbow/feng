import std$error;

// ===== Deque`T` — double-ended queue with ring buffer =====

export
class Deque`T` {
    var buf [*]T;
    var head int;
    var tail int;
    var size int;

    // ===== helper =====

    func dec(i int) int {
        if (i == 0) { return buf.length - 1; }
        return i - 1;
    }

    func grow() {
        if (size < buf.length) { return; }
        var newCap = buf.length * 2;
        var newBuf = new([newCap]T);
        for (var i = 0; i < size; i += 1) {
            newBuf[i] = buf[(head + i) % buf.length];
        }
        buf = newBuf;
        head = 0;
        tail = size;
    }

    // ===== add =====

    export func pushFront(e T) {
        grow();
        head = dec(head);
        buf[head] = e;
        size += 1;
    }

    export func pushBack(e T) {
        grow();
        buf[tail] = e;
        tail = (tail + 1) % buf.length;
        size += 1;
    }

    // ===== remove =====

    export func popFront() T {
        if (size == 0) { throw new(error$IllegalStateException); }
        var v = buf[head];
        head = (head + 1) % buf.length;
        size -= 1;
        return v;
    }

    export func popBack() T {
        if (size == 0) { throw new(error$IllegalStateException); }
        tail = dec(tail);
        var v = buf[tail];
        size -= 1;
        return v;
    }

    // ===== peek =====

    export func peekFront() T {
        if (size == 0) { throw new(error$IllegalStateException); }
        return buf[head];
    }

    export func peekBack() T {
        if (size == 0) { throw new(error$IllegalStateException); }
        return buf[dec(tail)];
    }

    // ===== properties =====

    export func length() int { return size; }
    export func isEmpty() bool { return size == 0; }

    export func clear() {
        head = 0; tail = 0; size = 0;
    }
}

// ===== factory functions =====

export func newDeque`T`() *Deque`T` {
    var d = new(Deque`T`, {buf=new([8]T)});
    return d;
}

export func newDequeCap`T`(cap int) *Deque`T` {
    var d = new(Deque`T`, {buf=new([cap]T)});
    var initCap = 8;
    if (cap > initCap) { initCap = cap; }
    d.buf = new([initCap]T);
    return d;
}

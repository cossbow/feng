import std$error;

// ===== Stack`T` — LIFO stack backed by Vector`T` =====

export
class Stack`T` {
    var list *Vector`T`;

    // ===== core =====

    export func push(e T) { list.append(e); }

    export func pop() T {
        if (list.isEmpty()) { throw new(error$IllegalStateException); }
        return list.removeLast();
    }

    export func peek() T {
        if (list.isEmpty()) { throw new(error$IllegalStateException); }
        return list.get(list.length() - 1);
    }

    // ===== properties =====

    export func size() int { return list.length(); }
    export func isEmpty() bool { return list.isEmpty(); }
    export func clear() { list.clear(); }
}

// ===== factory =====

export func newStack`T`() *Stack`T` {
    var s = new(Stack`T`);
    s.list = newVector`T`();
    return s;
}

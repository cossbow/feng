import std$error;

// ===== Vector`T` — dynamic array with auto-growth =====

export
class Vector`T` {
    var buf [*]T;    // internal buffer
    var len int;      // current element count

    // ===== helpers =====

    func ensureCapacity(need int) {
        if (buf == nil) {
            var cap = 8;
            if (need > cap) { cap = need; }
            buf = new([cap]T);
            return;
        }
        if (len + need <= buf.length) { return; }
        var newCap = buf.length * 2;
        if (newCap < len + need) { newCap = len + need; }
        var nb = new([newCap]T);
        for (var i = 0; i < len; i += 1) { nb[i] = buf[i]; }
        buf = nb;
    }

    func checkIndex(index int) {
        if (index < 0 || index >= len) { throw new(OutOfBoundsException); }
    }

    func checkInsertIndex(index int) {
        if (index < 0 || index > len) { throw new(OutOfBoundsException); }
    }

    // ===== capacity =====

    export func length() int { return len; }
    export func capacity() int {
        if (buf == nil) { return 0; }
        return buf.length;
    }
    export func isEmpty() bool { return len == 0; }

    // ===== add =====

    export func append(e T) {
        ensureCapacity(1);
        buf[len] = e;
        len += 1;
    }

    export func appendAll(src [&#]T) {
        var srcLen = src.length;
        ensureCapacity(srcLen);
        for (var i = 0; i < srcLen; i += 1) { buf[len + i] = src[i]; }
        len += srcLen;
    }

    export func insert(index int, e T) {
        checkInsertIndex(index);
        ensureCapacity(1);
        for (var i = len; i > index; i -= 1) { buf[i] = buf[i - 1]; }
        buf[index] = e;
        len += 1;
    }

    // ===== access =====

    export func get(index int) T { checkIndex(index); return buf[index]; }
    export func set(index int, value T) { checkIndex(index); buf[index] = value; }

    export func removeLast() T {
        if (len == 0) { throw new(error$IllegalStateException); }
        len -= 1;
        return buf[len];
    }

    export func removeAt(index int) T {
        checkIndex(index);
        var old = buf[index];
        for (var i = index; i < len - 1; i += 1) { buf[i] = buf[i + 1]; }
        len -= 1;
        return old;
    }

    // ===== search =====

    export func indexOf(value T) int {
        for (var i = 0; i < len; i += 1) { if (buf[i] == value) { return i; } }
        return -1;
    }

    export func lastIndexOf(value T) int {
        var i = len - 1;
        for (i >= 0) { if (buf[i] == value) { return i; } i -= 1; }
        return -1;
    }

    export func contains(value T) bool { return indexOf(value) != -1; }

    // ===== mutation =====

    export func clear() { len = 0; }

    export func truncate(newLen int) { if (newLen < len) { len = newLen; } }

    export func reverse() {
        var i = 0;
        var j = len - 1;
        for (i < j) {
            var tmp = buf[i];
            buf[i] = buf[j];
            buf[j] = tmp;
            i += 1; j -= 1;
        }
    }

    // ===== bulk =====

    export func copyTo(dst [&]T) int {
        var n = len;
        if (dst.length < n) { n = dst.length; }
        for (var i = 0; i < n; i += 1) { dst[i] = buf[i]; }
        return n;
    }
}

// ===== factory functions =====

export func newVector`T`() *Vector`T` { return new(Vector`T`); }

export func newVectorCap`T`(cap int) *Vector`T` {
    var v = new(Vector`T`);
    if (cap > 0) { v.buf = new([cap]T); }
    return v;
}

export func vectorFromArray`T`(src [&#]T) *Vector`T` {
    var v = newVector`T`();
    v.appendAll(src);
    return v;
}

// ===== HashSet`T` — backed by HashMap`T, Void` =====

export
struct Void {}

export
interface Set`T` {
    add(key T) bool;
    contains(key T) bool;
    remove(key T) bool;
    size() int;
    isEmpty() bool;
    clear();
}

export
class HashSet`T` (Set`T`) {
    const inner *HashMap`T,Void`;

    export
    func add(key T) bool {
        return inner.set(key, {}).ok;
    }

    export func contains(key T) bool {
        return inner.get(key).ok;
    }

    export func remove(key T) bool {
        return inner.remove(key).ok;
    }

    export func size() int { return inner.size(); }
    export func isEmpty() bool { return size() == 0; }
    export func clear() { inner.clear(); }

    export func toList() *Vector`T` {
        var list = newVector`T`();
        var it = inner.iterator();
        for (it.hasNext()) {
            list.append(it.key());
            it.next();
        }
        return list;
    }
}

// ===== factory =====

export
func newSet`T`(hashing Hashing`T,Void`) *HashSet`T` {
    return new(HashSet`T`, {
        inner = new(HashMap`T,Void`, {hashing=hashing})
    });
}

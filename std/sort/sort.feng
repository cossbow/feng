// ===== Insertion sort for small subarrays =====

func insertionSort`T`(arr [&!]T, lo, hi int, cmp func(T,T)int) {
    for (var i = lo + 1; i <= hi; i += 1) {
        var key = arr[i];
        var j = i - 1;
        for (j >= lo && cmp(key, arr[j]) < 0) {
            arr[j + 1] = arr[j];
            j -= 1;
        }
        arr[j + 1] = key;
    }
}

// ===== Quick sort =====

func quickSort`T`(arr [&!]T, lo, hi int, cmp func(T,T)int) {
    if (hi - lo < 16) {
        insertionSort`T`(arr, lo, hi, cmp);
        return;
    }
    // Median-of-three pivot
    var mid = (lo + hi) / 2;
    if (cmp(arr[mid], arr[lo]) < 0) {
        var tmp = arr[lo]; arr[lo] = arr[mid]; arr[mid] = tmp;
    }
    if (cmp(arr[hi], arr[lo]) < 0) {
        var tmp = arr[lo]; arr[lo] = arr[hi]; arr[hi] = tmp;
    }
    if (cmp(arr[hi], arr[mid]) < 0) {
        var tmp = arr[mid]; arr[mid] = arr[hi]; arr[hi] = tmp;
    }
    var tmp = arr[mid]; arr[mid] = arr[hi - 1]; arr[hi - 1] = tmp;
    var pivot = arr[hi - 1];
    var i = lo;
    var j = hi - 1;
    var scanning = true;
    for (scanning) {
        i += 1;
        for (cmp(arr[i], pivot) < 0) { i += 1; }
        j -= 1;
        for (cmp(pivot, arr[j]) < 0) { j -= 1; }
        if (i >= j) {
            scanning = false;
        } else {
            var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
        }
    }
    var t = arr[i]; arr[i] = arr[hi - 1]; arr[hi - 1] = t;
    quickSort`T`(arr, lo, i - 1, cmp);
    quickSort`T`(arr, i + 1, hi, cmp);
}

// ===== Public API =====

export
func sort`T`(arr [&!]T, cmp func(T,T)int) {
    if (arr.length <= 1) { return; }
    quickSort`T`(arr, 0, arr.length - 1, cmp);
}

export
func isSorted`T`(arr [&!#]T, cmp func(T,T)int) bool {
    for (var i = 1; i < arr.length; i += 1) {
        if (cmp(arr[i], arr[i - 1]) < 0) { return false; }
    }
    return true;
}

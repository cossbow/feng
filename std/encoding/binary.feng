// ===== Big-endian / Little-endian integer encoding =====

// ===== Big Endian =====

export func bigUint16(b [&#]byte) uint16 {
    return (uint16(b[0]) << 8) | uint16(b[1]);
}

export func bigUint32(b [&#]byte) uint32 {
    return (uint32(b[0]) << 24) |
           (uint32(b[1]) << 16) |
           (uint32(b[2]) << 8)  |
            uint32(b[3]);
}

export func bigUint64(b [&#]byte) uint64 {
    return (uint64(b[0]) << 56) |
           (uint64(b[1]) << 48) |
           (uint64(b[2]) << 40) |
           (uint64(b[3]) << 32) |
           (uint64(b[4]) << 24) |
           (uint64(b[5]) << 16) |
           (uint64(b[6]) << 8)  |
            uint64(b[7]);
}

export func putBigUint16(b [&]byte, v uint16) {
    b[0] = byte(v >> 8);
    b[1] = byte(v);
}

export func putBigUint32(b [&]byte, v uint32) {
    b[0] = byte(v >> 24);
    b[1] = byte(v >> 16);
    b[2] = byte(v >> 8);
    b[3] = byte(v);
}

export func putBigUint64(b [&]byte, v uint64) {
    b[0] = byte(v >> 56);
    b[1] = byte(v >> 48);
    b[2] = byte(v >> 40);
    b[3] = byte(v >> 32);
    b[4] = byte(v >> 24);
    b[5] = byte(v >> 16);
    b[6] = byte(v >> 8);
    b[7] = byte(v);
}

// ===== Little Endian =====

export func littleUint16(b [&#]byte) uint16 {
    return uint16(b[0]) | (uint16(b[1]) << 8);
}

export func littleUint32(b [&#]byte) uint32 {
    return uint32(b[0]) |
           (uint32(b[1]) << 8)  |
           (uint32(b[2]) << 16) |
           (uint32(b[3]) << 24);
}

export func littleUint64(b [&#]byte) uint64 {
    return uint64(b[0]) |
           (uint64(b[1]) << 8)  |
           (uint64(b[2]) << 16) |
           (uint64(b[3]) << 24) |
           (uint64(b[4]) << 32) |
           (uint64(b[5]) << 40) |
           (uint64(b[6]) << 48) |
           (uint64(b[7]) << 56);
}

export func putLittleUint16(b [&]byte, v uint16) {
    b[0] = byte(v);
    b[1] = byte(v >> 8);
}

export func putLittleUint32(b [&]byte, v uint32) {
    b[0] = byte(v);
    b[1] = byte(v >> 8);
    b[2] = byte(v >> 16);
    b[3] = byte(v >> 24);
}

export func putLittleUint64(b [&]byte, v uint64) {
    b[0] = byte(v);
    b[1] = byte(v >> 8);
    b[2] = byte(v >> 16);
    b[3] = byte(v >> 24);
    b[4] = byte(v >> 32);
    b[5] = byte(v >> 40);
    b[6] = byte(v >> 48);
    b[7] = byte(v >> 56);
}

// ===== Duration =====

export
class Duration final {
    const ns int64;

    export func nanoseconds() int64  { return ns; }
    export func microseconds() int64 { return ns / 1000; }
    export func milliseconds() int64 { return ns / 1000000; }
    export func seconds() float      { return float(ns) / 1e9; }

    export func add(other Duration) Duration {
        return {ns = ns + other.ns};
    }
    export func sub(other Duration) Duration {
        return {ns = ns - other.ns};
    }
    export func compare(other Duration) int {
        if (ns < other.ns) { return -1; }
        if (ns > other.ns) { return 1; }
        return 0;
    }
}

export func nanosecond(n int64)  Duration { return {ns = n}; }
export func microsecond(n int64) Duration { return {ns = n * 1000}; }
export func millisecond(n int64) Duration { return {ns = n * 1000000}; }
export func secondF(n float)     Duration { return {ns = int64(n * 1e9)}; }
export func minuteF(n float)     Duration { return {ns = int64(n * 6e10)}; }
export func hourF(n float)       Duration { return {ns = int64(n * 3.6e12)}; }

// ===== Unix timestamp decomposition (pure Feng) =====

func isLeapYear(y int) bool {
    return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
}

func daysInMonth(y, m int) int {
    if (m == 2) {
        if (isLeapYear(y)) { return 29; }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) { return 30; }
    return 31;
}

export
struct Datetime {
    year(32) uint64;
    month(4) uint64;
    day(6) uint64;
    hour(6) uint64;
    minute(6) uint64;
    second(6) uint64;
    weekday(4) uint64;
}

export
class Date final {
    const dt Datetime;
}

// Decompose Unix timestamp into date/time fields.
// sec: seconds since 1970-01-01 00:00:00 UTC.

func decomposeUnix(sec int64) Date {
    // Convert to days + time-of-day
    var days = int(sec / 86400);
    var rem = int(sec % 86400);
    if (rem < 0) {
        rem = rem + 86400;
        days = days - 1;
    }
    var hour = rem / 3600;
    rem = rem % 3600;
    var minute = rem / 60;
    var second = rem % 60;

    // Convert days to year/month/day
    // Days since 1970-01-01
    var y = 1970;
    var findingYear = true;
    for (findingYear) {
        var yearDays = 365;
        if (isLeapYear(y)) { yearDays = 366; }
        if (days < yearDays) {
            findingYear = false;
        } else {
            days = days - yearDays;
            y = y + 1;
        }
    }

    var m = 1;
    var findingMonth = true;
    for (findingMonth) {
        var md = daysInMonth(y, m);
        if (days < md) {
            findingMonth = false;
        } else {
            days = days - md;
            m = m + 1;
        }
    }
    var d = days + 1;

    // weekday: 1970-01-01 was Thursday (4)
    var wd = (int(sec / 86400) + 4) % 7;
    if (wd < 0) { wd = wd + 7; }

    return Date{dt = Datetime{
        year    = uint64(y),
        month   = uint64(m),
        day     = uint64(d),
        hour    = uint64(hour),
        minute  = uint64(minute),
        second  = uint64(second),
        weekday = uint64(wd),
    }};
}

// ===== Time =====

export
class Time final {
    export
    const sec  int64;
    export
    const nsec int64; // nanosecond within the second [0, 999999999]

    export func before(other Time) bool {
        return sec < other.sec
            || (sec == other.sec && nsec < other.nsec);
    }
    export func after(other Time) bool {
        return sec > other.sec
            || (sec == other.sec && nsec > other.nsec);
    }
    export func equals(other Time) bool {
        return sec == other.sec && nsec == other.nsec;
    }

    export func sub(other Time) Duration {
        return {ns = (sec - other.sec) * 1000000000
                   + int64(nsec - other.nsec)};
    }

    export func add(d Duration) Time {
        var extra_sec = d.ns / 1000000000;
        var ns_rem = int32(d.ns % 1000000000);
        var new_nsec = nsec + ns_rem;
        if (new_nsec >= 1000000000) {
            extra_sec = extra_sec + 1;
            new_nsec = new_nsec - 1000000000;
        } else if (new_nsec < 0) {
            extra_sec = extra_sec - 1;
            new_nsec = new_nsec + 1000000000;
        }
        return {sec = sec + extra_sec, nsec = new_nsec};
    }

    // Date decomposition (local time).
    export func date() Date {
        return decomposeUnix(sec);
    }
    export func year() int    { return int(date().dt.year); }
    export func month() int   { return int(date().dt.month); }
    export func day() int     { return int(date().dt.day); }
    export func hour() int    { return int(date().dt.hour); }
    export func minute() int  { return int(date().dt.minute); }
    export func second() int  { return int(date().dt.second); }
    export func weekday() int { return int(date().dt.weekday); }
}

// ===== Factory =====

export
func now() Time {
    var t Time;
    const r &!Time = t;
    timespec_get(uint64(r), 1);
    return t;
}

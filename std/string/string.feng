import std$encoding$utf8;
import std$error;

export
class String (Writable) {
    const value [*?#]byte;

    export
    func bytes#() [*?#]byte {
        return value;
    }

    export
    func byteLength() int {
        var v = value;
        if (v == nil) return 0;
        return v.length;
    }

    export
    func runeCount() int {
        var v = value;
        if (v == nil) return 0;
        return utf8$runeLen(v);
    }

    export
    func isEmpty() bool {
        var v = value;
        return v == nil || v.length == 0;
    }

    // Lexicographic comparison by byte values.
    // Returns negative if this < rhs, 0 if equal, positive if this > rhs.
    export
    func compare(rhs String) int {
        var v = value;
        var rv = rhs.value;
        if (v == nil) {
            if (rv == nil) { return 0; }
            return -1;
        }
        if (rv == nil) { return 1; }
        var len = v.length < rv.length ? v.length : rv.length;
        for (var i = 0; i < len; i += 1) {
            if (v[i] != rv[i]) {
                return int(v[i]) - int(rv[i]);
            }
        }
        return v.length - rv.length;
    }

    export
    func equals(other String) bool {
        return compare(other) == 0;
    }

    export
    func concat(other String) String {
        var v = value;
        var ov = other.value;
        if (v == nil) { return other; }
        if (ov == nil) {
            var n = v.length;
            var buf = new([n]byte);
            for (var i = 0; i < n; i += 1) { buf[i] = v[i]; }
            return {value=buf};
        }
        var n = v.length + ov.length;
        var buf = new([n]byte);
        for (var i = 0; i < v.length; i += 1) {
            buf[i] = v[i];
        }
        for (var i = 0; i < ov.length; i += 1) {
            buf[v.length + i] = ov[i];
        }
        return {value=buf};
    }

    // Find the byte offset of the first occurrence of rune ch.
    // Returns -1 if not found.
    export
    func indexOf(ch int32) int {
        var v = value;
        if (v == nil) { return -1; }
        var i = 0;
        var len = v.length;
        for (i < len) {
            var dec = utf8$decodeRune(v, i);
            if (int32(dec.0) == ch) { return i; }
            i += dec.1;
        }
        return -1;
    }

    // Find the byte offset of the first occurrence of substring sub.
    // Returns -1 if not found.
    export
    func indexOfStr(sub String) int {
        var v = value;
        var sv = sub.value;
        if (v == nil || sv == nil) { return -1; }
        var subLen = sv.length;
        if (subLen == 0) { return 0; }
        var end = v.length - subLen;
        for (var i = 0; i <= end; i += 1) {
            var match = true;
            for (var j = 0; j < subLen; j += 1) {
                if (v[i + j] != sv[j]) {
                    match = false;
                    break;
                }
            }
            if (match) { return i; }
        }
        return -1;
    }

    export
    func contains(sub String) bool {
        return indexOfStr(sub) >= 0;
    }

    export
    func startsWith(prefix String) bool {
        var v = value;
        var pv = prefix.value;
        if (v == nil || pv == nil) { return pv == nil; }
        if (pv.length > v.length) { return false; }
        for (var i = 0; i < pv.length; i += 1) {
            if (v[i] != pv[i]) { return false; }
        }
        return true;
    }

    export
    func endsWith(suffix String) bool {
        var v = value;
        var sv = suffix.value;
        if (v == nil || sv == nil) { return sv == nil; }
        if (sv.length > v.length) { return false; }
        var start = v.length - sv.length;
        for (var i = 0; i < sv.length; i += 1) {
            if (v[start + i] != sv[i]) { return false; }
        }
        return true;
    }

    // Substring by byte offsets [start, end).
    // Throws IllegalArgumentException if start < 0, end < 0, or start > end.
    export
    func substring(start, end int) String {
        if (start < 0 || end < 0 || start > end) {
            throw new(error$IllegalArgumentException);
        }
        var v = value;
        if (v == nil || end == 0) { return EMPTY; }
        var e = end;
        if (e > v.length) { e = v.length; }
        var s = start;
        if (s >= e) { return EMPTY; }
        var n = e - s;
        var buf = new([n]byte);
        for (var i = 0; i < n; i += 1) {
            buf[i] = v[s + i];
        }
        return {value=buf};
    }

    // Get the rune at character index (not byte index).
    // Throws OutOfBoundsException if index is out of range.
    export
    func rune(index int) int32 {
        if (index < 0) { throw new(OutOfBoundsException); }
        var v = value;
        if (v == nil) { throw new(OutOfBoundsException); }
        var i = 0;
        var count = 0;
        var len = v.length;
        for (i < len) {
            if (count == index) {
                var dec = utf8$decodeRune(v, i);
                return dec.0;
            }
            var dec = utf8$decodeRune(v, i);
            i += dec.1;
            count += 1;
        }
        throw new(OutOfBoundsException);
    }

    // Split the string by separator sep.
    // Returns a dynamic array of substrings.
    export
    func split(sep String) [*]String {
        var v = value;
        var sv = sep.value;
        if (v == nil) { return new([1]String); }
        if (sv == nil || sv.length == 0) {
            var r = new([1]String);
            var buf = new([v.length]byte);
            for (var i = 0; i < v.length; i += 1) {
                buf[i] = v[i];
            }
            r[0] = {value=buf};
            return r;
        }
        // Count separators
        var sepLen = sv.length;
        var count = 0;
        var pos = 0;
        for (pos + sepLen <= v.length) {
            var match = true;
            for (var j = 0; j < sepLen; j += 1) {
                if (v[pos + j] != sv[j]) {
                    match = false;
                    break;
                }
            }
            if (match) {
                count += 1;
                pos += sepLen;
            } else {
                pos += 1;
            }
        }
        // Build result
        var resultSize = count + 1;
        var result = new([resultSize]String);
        var idx = 0;
        var start = 0;
        pos = 0;
        for (pos + sepLen <= v.length) {
            var match = true;
            for (var j = 0; j < sepLen; j += 1) {
                if (v[pos + j] != sv[j]) {
                    match = false;
                    break;
                }
            }
            if (match) {
                // Extract [start, pos)
                if (pos > start) {
                    var n = pos - start;
                    var buf = new([n]byte);
                    for (var k = 0; k < n; k += 1) {
                        buf[k] = v[start + k];
                    }
                    result[idx] = {value=buf};
                } else {
                    result[idx] = EMPTY;
                }
                idx += 1;
                start = pos + sepLen;
                pos = start;
            } else {
                pos += 1;
            }
        }
        // Last part
        if (start < v.length) {
            var n = v.length - start;
            var buf = new([n]byte);
            for (var k = 0; k < n; k += 1) {
                buf[k] = v[start + k];
            }
            result[idx] = {value=buf};
        } else {
            result[idx] = EMPTY;
        }
        return result;
    }

    // Replace all occurrences of oldStr with newStr.
    export
    func replace(oldStr, newStr String) String {
        var v = value;
        var ov = oldStr.value;
        var nv = newStr.value;
        if (v == nil) { return EMPTY; }
        if (ov == nil || ov.length == 0) { return {value=v}; }
        // First, count occurrences to allocate result
        var oldLen = ov.length;
        var count = 0;
        var end = v.length - oldLen;
        var i = 0;
        for (i <= end) {
            var match = true;
            for (var j = 0; j < oldLen; j += 1) {
                if (v[i + j] != ov[j]) {
                    match = false;
                    break;
                }
            }
            if (match) {
                count += 1;
                i += oldLen;
            } else {
                i += 1;
            }
        }
        if (count == 0) { return {value=v}; }
        // Allocate result buffer
        var nLen int = 0;
        if (nv != nil) { nLen = nv.length; }
        var resultLen = v.length - count * oldLen + count * nLen;
        var buf = new([resultLen]byte);
        var wi = 0;
        var ri = 0;
        for (ri <= end) {
            var match = true;
            for (var j = 0; j < oldLen; j += 1) {
                if (v[ri + j] != ov[j]) {
                    match = false;
                    break;
                }
            }
            if (match) {
                // Write newStr
                if (nv != nil) {
                    for (var j = 0; j < nLen; j += 1) {
                        buf[wi] = nv[j];
                        wi += 1;
                    }
                }
                ri += oldLen;
            } else {
                buf[wi] = v[ri];
                wi += 1;
                ri += 1;
            }
        }
        // Copy remaining
        for (ri < v.length) {
            buf[wi] = v[ri];
            wi += 1;
            ri += 1;
        }
        return {value=buf};
    }

    // Trim leading and trailing ASCII whitespace (space, tab, newline, carriage return).
    export
    func trim() String {
        var v = value;
        if (v == nil || v.length == 0) { return EMPTY; }
        var start = 0;
        var end = v.length;
        // Trim left
        for (start < end) {
            var c = v[start];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            start += 1;
        }
        // Trim right
        for (end > start) {
            var c = v[end - 1];
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            end -= 1;
        }
        if (start >= end) { return EMPTY; }
        var n = end - start;
        var buf = new([n]byte);
        for (var i = 0; i < n; i += 1) {
            buf[i] = v[start + i];
        }
        return {value=buf};
    }

    // Convert ASCII uppercase letters to lowercase.
    export
    func toLower() String {
        var v = value;
        if (v == nil) { return EMPTY; }
        var buf = new([v.length]byte);
        for (var i = 0; i < v.length; i += 1) {
            var c = v[i];
            if (c >= 65 && c <= 90) {  // 'A'..'Z'
                buf[i] = byte(int(c) + 32);
            } else {
                buf[i] = c;
            }
        }
        return {value=buf};
    }

    // Convert ASCII lowercase letters to uppercase.
    export
    func toUpper() String {
        var v = value;
        if (v == nil) { return EMPTY; }
        var buf = new([v.length]byte);
        for (var i = 0; i < v.length; i += 1) {
            var c = v[i];
            if (c >= 97 && c <= 122) {  // 'a'..'z'
                buf[i] = byte(int(c) - 32);
            } else {
                buf[i] = c;
            }
        }
        return {value=buf};
    }

    // Writable implementation
    export
    func write#(w &Writer) int {
        var v = value;
        if (v == nil) return 0;
        w.write(v, 0, v.length);
        return v.length;
    }
}

// Factory functions

export
func fromUtf8(data [*#]byte) String {
    return {value=data};
}

export
func fromBytes(data [*#]byte) String {
    return {value=data};
}

// Join an array of Strings with a separator.
export
func join(parts [&#]String, sep String) String {
    var sepv = sep.value;
    if (parts.length == 0) { return EMPTY; }
    if (parts.length == 1) {
        var s = parts[0];
        var sv = s.value;
        if (sv == nil) { return EMPTY; }
        var buf = new([sv.length]byte);
        for (var i = 0; i < sv.length; i += 1) {
            buf[i] = sv[i];
        }
        return {value=buf};
    }
    // Calculate total length
    var sepLen = 0;
    if (sepv != nil) { sepLen = sepv.length; }
    var totalLen = 0;
    for (var i = 0; i < parts.length; i += 1) {
        var s = parts[i];
        var sv = s.value;
        if (sv != nil) { totalLen += sv.length; }
    }
    totalLen += sepLen * (parts.length - 1);
    // Build result
    var buf = new([totalLen]byte);
    var pos = 0;
    for (var i = 0; i < parts.length; i += 1) {
        var s = parts[i];
        var sv = s.value;
        if (sv != nil) {
            for (var j = 0; j < sv.length; j += 1) {
                buf[pos] = sv[j];
                pos += 1;
            }
        }
        if (i < parts.length - 1 && sepv != nil) {
            for (var j = 0; j < sepLen; j += 1) {
                buf[pos] = sepv[j];
                pos += 1;
            }
        }
    }
    return {value=buf};
}

export
const EMPTY String = {value=nil};

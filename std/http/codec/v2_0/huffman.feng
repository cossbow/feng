// 解码 data[from..from+length) 为 HPACK Huffman 编码串（RFC 7541 §5.2）。
// 返回 (解码字节, ok)。错误：EOS 出现、路径中断、末尾填充 >7 位或非全 1。
// 两遍扫描：第一遍计数并验证，第二遍填充输出。

func walk(data [&#]byte, from, length int, out [*]byte, write bool) (int, bool) {
    var node = 0;          // trie 当前节点
    var pending = 0;       // 自上一个完整符号以来未匹配的位数
    var allOnes = true;    // 这些未匹配位是否全为 1（合法填充须为 EOS 前缀）
    var count = 0;
    var end = from + length;
    for (var i = from; i < end; i += 1) {
        var b = int(data[i]);
        for (var k = 7; k >= 0; k -= 1) {
            var bit = (b >> k) & 1;
            var child = 0;
            if (bit == 0) { child = HUFF_TRIE[node].c0; }
            else { child = HUFF_TRIE[node].c1; }
            if (child < 0) { return (0, false); }   // 路径中断
            node = child;
            var sym = HUFF_TRIE[node].sym;
            if (sym >= 0) {
                if (sym == 256) { return (0, false); }  // EOS 出现
                if (write) { out[count] = byte(sym); }
                count += 1;
                node = 0;
                pending = 0;
                allOnes = true;
            } else {
                pending += 1;
                if (bit == 0) { allOnes = false; }
            }
        }
    }
    if (node != 0) {        // 末尾未匹配位：仅允许 ≤7 位全 1（EOS 前缀填充）
        if (pending > 7 || !allOnes) { return (0, false); }
    }
    return (count, true);
}

export
func huffmanDecode(data [&#]byte, from, length int) ([*?#]byte, bool) {
    var r = walk(data, from, length, new([0]byte), false);
    if (!r.1) { return (nil, false); }
    if (r.0 <= 0) { return (new([0]byte), true); }
    var buf = new([r.0]byte);
    r = walk(data, from, length, buf, true);
    if (!r.1) { return (nil, false); }
    return (buf, true);
}

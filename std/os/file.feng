import std$string;

export
enum OpenMode {
    Read,
    Write,
    Append,
    ReadWrite,
    ReadBinary,
    WriteBinary,
    AppendBinary,
    ReadWriteBinary,
}

export
class File (Writer,Reader) {
    const fp uint64;

    macro resource free() {
        fclose(fp);
    }

    export
    func read#(buf [&]byte) int {
        var n = fread(buf.values, 1, uint64(buf.length), fp);
        if (n <= 0) {
            return -1;
        }
        return int(n);
    }

    export
    func write(data [&#]byte, offset, length int) int {
        if (offset>=data.length) return 0;
        var pos = data.values+uint64(offset);
        var len = length<data.length ? length : data.length;
        var n = fwrite(pos, 1, uint64(len), fp);
        return int(n);
    }

    export
    func seek(offset int, whence int) int {
        var n = fseek(fp, int64(offset), int32(whence));
        return int(n);
    }

    export
    func tell() int {
        return int(ftell(fp));
    }

    export
    func eof() bool {
        return feof(fp) != 0;
    }

    export
    func error() bool {
        return ferror(fp) != 0;
    }
}

func file(fp uint64) *File {
    return new(File, {fp=fp});
}

//
// C string helpers
//

func toCStr(s [&#]byte) [*]byte {
    var bufSize = s.length + 1;
    var buf = new([bufSize]byte);
    for (var i = 0; i < s.length; i += 1) {
        buf[i] = s[i];
    }
    buf[s.length] = 0;
    return buf;
}

func openModeToStr(mode OpenMode) [4]byte {
    var id = mode.id;
    if (id == 0) { return "r"; }
    if (id == 1) { return "w"; }
    if (id == 2) { return "a"; }
    if (id == 3) { return "r+"; }
    if (id == 4) { return "rb"; }
    if (id == 5) { return "wb"; }
    if (id == 6) { return "ab"; }
    return "wb+";
}

//
// factory
//

export
func open(path [&#]byte, mode OpenMode) *File {
    var cpath = toCStr(path);
    var cmode = openModeToStr(mode);
    var fp = fopen(cpath.values, cmode.values);
    return file(fp);
}

func strLen(len int) int {
    return len / 2;
}

export
const stdin = file(__acrt_iob_func(0));
export
const stdout = file(__acrt_iob_func(1));
export
const stderr = file(__acrt_iob_func(2));

export
func printf(fmt [&#]byte, ...) {
    format(stdout, fmt, ...);
}

// ========== OS utility functions ==========

// Helper: convert a null-terminated C string (from a buffer) to Fēng String.
func cBufToString(buf [*#]byte, maxLen int) string$String {
    var len = 0;
    for (len < maxLen && buf[len] != 0) {
        len += 1;
    }
    if (len == 0) { return string$EMPTY; }
    var result = new([len]byte);
    for (var i = 0; i < len; i += 1) {
        result[i] = buf[i];
    }
    return string$utf8(result);
}

// ===== Directory operations =====

// Create a directory. Returns true on success.
export
func makeDir(path [&#]byte) bool {
    var cpath = toCStr(path);
    return mkdir(cpath.values) == 0;
}

// Remove a file. Returns true on success.
export
func removeFile(path [&#]byte) bool {
    var cpath = toCStr(path);
    return remove(cpath.values) == 0;
}

// Remove an empty directory. Returns true on success.
export
func removeDir(path [&#]byte) bool {
    var cpath = toCStr(path);
    return rmdir(cpath.values) == 0;
}

// ===== File/path existence =====

// Check if a file or directory exists.
export
func exists(path [&#]byte) bool {
    var cpath = toCStr(path);
    return access(cpath.values, 0) == 0;
}

// Check if a file or directory is readable.
export
func isReadable(path [&#]byte) bool {
    var cpath = toCStr(path);
    return access(cpath.values, 4) == 0;
}

// Check if a file or directory is writable.
export
func isWritable(path [&#]byte) bool {
    var cpath = toCStr(path);
    return access(cpath.values, 2) == 0;
}

// ===== Environment variables =====

// Get an environment variable. Returns empty string if not set.
export
func getEnvVar(name [&#]byte) string$String {
    var cname = toCStr(name);
    var ptr = getenv(cname.values);
    if (ptr == 0) { return string$EMPTY; }
    var len = int(strlen(ptr));
    if (len == 0) { return string$EMPTY; }
    var buf = new([len]byte);
    memcpy(buf.values, ptr, uint64(len));
    return string$utf8(buf);
}

// Set an environment variable. Returns true on success.
export
func setEnvVar(name, value [&#]byte) bool {
    // Build "NAME=VALUE" string
    var totalLen = name.length + value.length + 1;
    var env = new([totalLen + 1]byte);
    var pos = 0;
    for (var i = 0; i < name.length; i += 1) {
        env[pos] = name[i]; pos += 1;
    }
    env[pos] = 61; pos += 1;  // '='
    for (var i = 0; i < value.length; i += 1) {
        env[pos] = value[i]; pos += 1;
    }
    env[pos] = 0;
    return putenv(env.values) == 0;
}

// ===== Current directory =====

// Get the current working directory.
export
func getWorkDir() string$String {
    var buf = new([4096]byte);
    var ptr = getcwd(buf.values, 4096);
    if (ptr == 0) { return string$EMPTY; }
    return cBufToString(buf, 4096);
}

// Change the current working directory. Returns true on success.
export
func changeDir(path [&#]byte) bool {
    var cpath = toCStr(path);
    return chdir(cpath.values) == 0;
}

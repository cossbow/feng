// ===== 异步 echo server：Proactor 端到端（单线程事件循环 + 多连接 + in-flight 表）=====
//
// 架构见 docs/net-event-plan.md §3.4/§4：
//   - 事件循环在线程内运行（std$async 的 Task/start 边界），submitXxx 提交 → poll 分发完成事件；
//   - token → (socket, buffer) 的 in-flight 表在事件循环层，单线程访问，无需原子；
//   - @Async 边界在 std$net 内部 innerSubmit，真正把 buffer 交给内核；
//   - 监听 socket 留在主线程、accept 全部预先提交，事件循环任务只持有 proactor + done 信号。

import std$testing;
import std$async;
import std$net n;

const maxClients = 4;
const nClients = 3;

// 每条已接受连接的一条 in-flight 记录：socket + 当前 token + 读写 buffer。
// buffer 须 @Sync（穿过 innerSubmit 的 @Async 边界）；socket 的 fd 以值传入，无需 @Sync。
class Conn {
    var sock *n$Socket;
    var token uint64;
    @Sync var buf *n$Buf;
}

// 事件循环任务：@Async 的 run() 内只做单线程 poll 分发。
// 仅引用字段均标 @Sync（pro/done），整体可同步，可经 async$start 跨线程。
class EchoServer (async$Task) {
    @Sync var pro *n$Proactor;
    @Sync var done *async$AtomicInt32;
    var total int;

    @Async func run() {
        // in-flight 表：单线程事件循环内，普通强引用即可（无 @Sync）。
        var conns [maxClients]*?Conn;
        var events [8]n$Completion;
        var closed = 0;

        for (closed < total) {
            var nReady = int(pro.poll(events, int32(50)));
            for (var i = 0; i < nReady; i += 1) {
                var ev = events[i];
                if (ev.op == n$PRO_ACCEPT) {
                    // 接受连接：包装 fd → 关联 IOCP → 提交首个读。
                    var sock = n$socketFromFd(int(ev.result));
                    pro.associate(sock);
                    @Sync var buf = new(n$Buf);
                    var t = pro.submitRead(sock, buf);
                    var slot = -1;
                    for (var j = 0; j < maxClients; j += 1) {
                        if (conns[j] == nil) { slot = j; break; }
                    }
                    if (slot >= 0) {
                        conns[slot] = new(Conn, {sock = sock, token = t, buf = buf});
                    }
                } else {
                    var idx = -1;
                    for (var j = 0; j < maxClients; j += 1) {
                        var cc = conns[j];
                        if (cc != nil && cc.token == ev.token) { idx = j; break; }
                    }
                    if (idx >= 0) {
                        var c = conns[idx];
                        if (c != nil) {
                            if (ev.op == n$PRO_READ) {
                                if (ev.result > int32(0)) {
                                    // 有数据：echo 写回（同一 buffer，只写读到的字节数）。
                                    c.token = pro.submitWrite(c.sock, c.buf, ev.result);
                                } else {
                                    // EOF/错误：移除记录，触发 Socket 析构关闭 fd。
                                    conns[idx] = nil;
                                    closed += 1;
                                }
                            } else if (ev.op == n$PRO_WRITE) {
                                // 写完成：继续读（等待下一段数据或 EOF）。
                                c.token = pro.submitRead(c.sock, c.buf);
                            }
                        }
                    }
                }
            }
        }
        done.fetchAdd(int32(1));
    }
}

@Test
func testAsyncEchoMultiConn() {
    var addr = n$ip4(127, 0, 0, 1, 20100);
    var listener = n$listenTCP(addr);
    testing$assertTrue(listener != nil);

    @Sync var pro = n$newProactor();
    testing$assertTrue(pro != nil);

    // 监听 socket 留在主线程（非 sync，因 fd 以值传入不穿边界）；一次性预提交全部 accept。
    pro.associate(listener);
    for (var i = 0; i < nClients; i += 1) {
        pro.submitAccept(listener);
    }

    @Sync var done = async$newAtomicInt32(int32(0));
    @Sync var task = new(EchoServer, {pro = pro, done = done, total = nClients});
    async$start(task);

    // 建立 nClients 条并发连接。
    var clients [maxClients]*?n$Socket;
    for (var i = 0; i < nClients; i += 1) {
        clients[i] = n$dial(addr);
        testing$assertTrue(clients[i] != nil);
    }

    // 每条连接 echo 一段数据（末字节区分连接，验证 in-flight 分发正确）。
    for (var i = 0; i < nClients; i += 1) {
        var c = clients[i];
        if (c != nil) {
            var msg [5]byte = [72, 101, 108, 108, 111];   // "Hello"
            msg[4] = byte(111 + i);
            var nw = c.write(msg, 0, 5);
            testing$assertTrue(nw == 5);
            var rbuf [8]byte;
            var nr = c.read(rbuf);
            testing$assertTrue(nr == 5);
            testing$assertTrue(rbuf[0] == 72 && rbuf[4] == msg[4]);
        } else {
            testing$assertTrue(false);
        }
    }

    // 关闭全部连接，触发服务端 EOF。
    for (var i = 0; i < nClients; i += 1) {
        var c = clients[i];
        if (c != nil) { c.close(); }
    }

    // 等待事件循环观察到全部 EOF 并置位 done。
    for (done.load() == int32(0)) { }
    testing$assertTrue(done.load() == int32(1));

    pro.close();
    listener.close();
}

// 超时操作：提交 submitTimeout 后 poll 应取回 PRO_TIMEOUT 完成事件（token 匹配）。
@Test
func testProactorTimeout() {
    @Sync var pro = n$newProactor();
    testing$assertTrue(pro != nil);

    var token = pro.submitTimeout(int32(100));   // 100ms 后触发

    var events [1]n$Completion;
    var nReady = pro.poll(events, int32(2000));  // 至多等 2s
    testing$assertTrue(nReady == 1);
    testing$assertTrue(events[0].op == n$PRO_TIMEOUT);
    testing$assertTrue(events[0].token == token);

    pro.close();
}

// 异步 connect：未连接 socket 经 submitConnect 后 poll 取回 PRO_CONNECT（result==0），
// 并验证监听端确实 accept 到该连接（覆盖 ip/port 打包透传）。
@Test
func testProactorConnect() {
    var addr = n$ip4(127, 0, 0, 1, 20101);
    var listener = n$listenTCP(addr);
    testing$assertTrue(listener != nil);

    @Sync var pro = n$newProactor();
    testing$assertTrue(pro != nil);

    // 未连接 socket：先关联 IOCP，再提交异步 connect（fd 以值传入，无需 @Sync）。
    var client = n$newSocket();
    testing$assertTrue(client != nil);
    testing$assertTrue(pro.associate(client));

    var token = pro.submitConnect(client, addr);

    var events [1]n$Completion;
    var nReady = pro.poll(events, int32(2000));
    testing$assertTrue(nReady == 1);
    testing$assertTrue(events[0].op == n$PRO_CONNECT);
    testing$assertTrue(events[0].token == token);
    testing$assertTrue(events[0].result == int32(0));   // 0 = 成功

    // 连接已建立：监听端 accept 应立即返回（不阻塞）。
    var acc = listener.accept();
    testing$assertTrue(acc.0 != nil);

    client.close();
    acc.0.close();
    listener.close();
    pro.close();
}

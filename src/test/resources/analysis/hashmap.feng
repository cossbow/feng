
class Node final {
    var key int;
    var value *Object;
    var next *Node;
}

class HashMap {
    var buckets [*]*Node;
    var size int;
    var threshold int;

    func indexed(k int) int {
        var b = buckets;
        if (b == nil) return 0;
        return k % b.length;
    }

    func rehash() [*]*Node {
        var b = buckets;
        if (b == nil) {
            var newBuck = new([16]*Node);
            buckets = newBuck;
            threshold = int(float32(newBuck.length) * 0.75);
            return newBuck;
        }

        if (size < threshold) {
            return b;
        }

        var cap = b.length << 1;
        var newBuck = new([cap]*Node);
        for (var i=0; i<b.length; i += 1) {
            var cur = b[i];
            for (cur != nil) {
                var next = cur.next;
                var idx = cur.key % cap;
                cur.next = newBuck[idx];
                newBuck[idx] = cur;
                cur = next;
            }
        }
        b = newBuck;
        buckets = b;
        threshold = int(float32(b.length) * 0.75);
        return b;
    }

    func set(key int, value *Object) *Object {
        var bucks = rehash();
        if (bucks == nil) return nil;
        var idx = indexed(key);
        var cur = bucks[idx];
        if (cur == nil) {
            bucks[idx] = new(Node, {key=key,value=value});
            size += 1;
            return nil;
        }

        var prev *Node = nil;
        for (cur != nil) {
            if (key == cur.key) {
                var o = cur.value;
                cur.value = value;
                return o;
            }
            prev = cur;
            cur = cur.next;
        }
        if (prev == nil) return nil;
        prev.next = new(Node, {key=key,value=value});

        size += 1;

        return nil;
    }

    func get(key int) *Object {
        var b = buckets;
        if (b == nil) return nil;
        var idx = indexed(key);
        var cur = b[idx];
        if (cur == nil) {
            return nil;
        }

        for (cur != nil && cur.key != key) {
            cur = cur.next;
        }
        if (cur == nil) return nil;
        return cur.value;
    }
}

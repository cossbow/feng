
class Result`V` final {
    var v V;
    var ok bool;
}

class Node`K, V` final {
    var key K;
    var value V;
    var next *?Node`K, V`;
}

class HashMap`K, V` {
    const hashing func(k K) int;
    var buckets [*?]*?Node`K, V`;
    var size int;
    var threshold int;

    func rehash() [*]*?Node`K, V` {
        var bucks = buckets;
        if (bucks == nil) {
            bucks = new([16]*?Node`K, V`);
        } else if (size < threshold) {
            return bucks;
        } else {
            var cap = bucks.length << 1;
            var newBuck = new([cap]*?Node`K, V`);
            for (var i=0; i<bucks.length; i += 1) {
                var cur = bucks[i];
                for (cur != nil) {
                    var next = cur.next;
                    var idx = hashing(cur.key) % cap;
                    cur.next = newBuck[idx];
                    newBuck[idx] = cur;
                    cur = next;
                }
            }
            bucks = newBuck;
        }
        if (bucks==nil) throw new(NilException);
        buckets = bucks;
        threshold = int(float32(bucks.length) * 0.75);
        return bucks;
    }

    func set(key K, value V) Result`V` {
        var bucks = rehash();
        var idx = hashing(key)&(bucks.length);
        var cur = bucks[idx];
        if (cur == nil) {
            bucks[idx] = new(Node`K, V`, {key=key,value=value});
            size += 1;
            return {ok=true};
        }

        var prev *?Node`K, V` = nil;
        for (cur != nil) {
            if (key == cur.key) {
                var old = cur.value;
                cur.value = value;
                return {v=old};
            }
            prev = cur;
            cur = cur.next;
        }
        if (prev==nil) throw new(NilException);
        prev.next = new(Node`K, V`, {key=key,value=value});

        size += 1;

        return {ok=true};
    }

    func get(key K) Result`V` {
        var bucks = buckets;
        if (bucks == nil) {
            return {};
        }
        var idx = hashing(key)&(bucks.length);
        var cur = bucks[idx];

        for (cur != nil && cur.key != key) {
            cur = cur.next;
        }
        if (cur == nil) return {};
        return {ok=true, v=cur.value};
    }
}

func newHashmap`K,V`(hashing func(k K)int) *HashMap`K,V` {
    return new(HashMap`K,V`, {hashing=hashing});
}

func intHashing(k int) int {
    return (k);
}

func test(n int) {
    var map = newHashmap`int,int`(intHashing);
    for(var i=0;i<n;i+=1) {
        map.set(i, i+100);
    }
    if (var r=map.get(-1); r.ok){}
    if (var r=map.get(0); r.ok){}
    if (var r=map.get(1); r.ok){}
    if (var r=map.get(99); r.ok){}
    if (var r=map.get(100); r.ok){}
    if (var r=map.get(101); r.ok){}
}

func main() {
    test(15);
}

class Node`K, V` final {
    const key K;
    var value V;
    var next *Node`K, V`;
}

export
class HashMap`K, V` {
    const hashing !func(k K) int;
    var buckets [*]*Node`K, V`;
    var size int;
    var threshold int;

    func indexed(k K) int {
        var b = buckets;
        if (b == nil) return 0;
        var h = hashing(k);
        return h & (b.length-1);
    }

    func rehash() [*]*Node`K, V` {
        var b = buckets;
        if (b == nil) {
            var newBuck = new([16]*Node`K, V`);
            buckets = newBuck;
            threshold = int(float32(newBuck.length) * 0.75);
            return newBuck;
        }

        if (size < threshold) {
            return b;
        }

        var cap = b.length << 1;
        var newBuck = new([cap]*Node`K, V`);
        for (var i=0; i<b.length; i += 1) {
            var cur = b[i];
            for (cur != nil) {
                var next = cur.next;
                var idx = hashing(cur.key) % cap;
                cur.next = newBuck[idx];
                newBuck[idx] = cur;
                cur = next;
            }
        }
        b = newBuck;
        buckets = b;
        threshold = int(float32(b.length) * 0.75);
        return b;
    }

    export
    func set(key K, value V) (V, bool) {
        var zero V;
        var bucks = rehash();
        if (bucks == nil) return (zero, true);
        var idx = indexed(key);
        var cur = bucks[idx];
        if (cur == nil) {
            bucks[idx] = new(Node`K, V`, {key=key,value=value});
            size += 1;
            return (zero, true);
        }

        var prev *Node`K, V` = nil;
        for (cur != nil) {
            if (key == cur.key) {
                var old = cur.value;
                cur.value = value;
                return (old, false);
            }
            prev = cur;
            cur = cur.next;
        }
        if (prev == nil) return (zero, true);
        prev.next = new(Node`K, V`, {key=key,value=value});

        size += 1;

        return (zero, true);
    }

    export
    func get(key K) (V, bool) {
        var zero V;
        var b = buckets;
        if (b == nil) return (zero, false);
        var idx = indexed(key);
        var cur = b[idx];
        if (cur == nil) {
            return (zero, false);
        }

        for (cur != nil && cur.key != key) {
            cur = cur.next;
        }
        if (cur == nil) return (zero, false);
        return (cur.value, true);
    }
}

export
func newHashmap`K,V`(hashing !func(k K)int) *HashMap`K,V` {
    return new(HashMap`K,V`, {hashing=hashing});
}


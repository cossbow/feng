class A {
    var n [*]*A;
}
func make(n int) *A {
    if (n<1) return nil;
    var a = new(A, {n=new([4]*A)});
    for(var i=0; i<n; i+=1) {
        a.n[i] = make(n-1);
    }
    return a;
}
func test(n int) {
    var a = make(n);
    var r = a.n[0];
}

func main(args [&!#][*!#]byte) {
    test(2);
	test(21);
}

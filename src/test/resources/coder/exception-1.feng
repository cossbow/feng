

class MyException:Exception {
}

func task() {
    throw new(MyException);
}

func main(args [&#][*#]byte) {
    try{
        task();
    } catch (e *#MyException) {
        var l = e.line;
    }
    try{
        task();
    } catch (o *#Exception) {
        var e = o?(*?#MyException);
        if (e==nil) return;
        var l = e.line;
    }
}

class A {
    var v,u int;
    func get() int { return v; }
    func get2() int { return u; }
}

class B : A {
    var w,r int;
    func get() int { return super.get2(); }
    func get2() int { return r; }
}

class C : B {
    func get() int { return super.get(); }
    func get2() int { return super.get2(); }
}

func main() {
    var b = new(B, {v=42, u=43, w=7, r=8});
    assert (b.get() == 43);
    assert (b.get2() == 8);
    var c = new(C, {v=42, u=43, w=7, r=8});
    assert (c.get() == 43);
    assert (c.get2() == 8);
}


class NilWriter (Writer) {
    var buf [*!]byte;
    var size int;
    func write(data [&!#]byte, offset int, length int) int {
        size = length;
        return length;
    }
}

class Buffer (Writable) {
    const data [*!#]byte;
    func write#(w &!Writer) int {
        return w.write(data,0,data.length);
    }
}

func main() {
    var b NilWriter = {buf=new([64]byte)};
    var s Buffer = {data="feng"};
    format(b, "Hello {}!\n", s);
    assert(b.size == 5);
}

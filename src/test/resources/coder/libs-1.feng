import std$map m;
import std$os;

func intHash(n &#m$Node`int,int`) int {
    return n.key;
}
func intEq(a,b &#m$Node`int,int`) bool {
    return a.key == b.key;
}


func test(n int) {
    var map = m$newHashmap`int,int`({
        hash=intHash, equal=intEq
    });
    for(var i=0;i<n;i+=1) {
        map.set(i, i+100);
    }
    if (var r=map.get(-1); r.ok){}
    if (var r=map.get(0); r.ok){}
    if (var r=map.get(1); r.ok){}
    if (var r=map.get(99); r.ok){}
    if (var r=map.get(100); r.ok){}
    if (var r=map.get(101); r.ok){}
}

func main() {
    test(5);
}


interface I {
    run();
}
class A (I) {
    var id int;
    func run() {}
}
class B:A{
}
class C:B{
    func run() {}
}

func test(n int) {
    var i1 *I = new(A);
    if (i1 == nil) return;
    i1.run(); // A.run
    var i2 *I = new(B);
    if (i2 == nil) return;
    i2.run(); // A.run
    var i3 *I = new(C);
    if (i3 == nil) return;
    i3.run(); // C.run
    var b *B = new(C);
    if (b == nil) return;
    b.run(); // C.run
}

func main(args [&!#][*!#]byte) {
    test(15);
}
